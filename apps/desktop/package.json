{
  "name": "@chatick/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "electron . --dev",
    "build": "echo \"desktop: packaging via electron-builder (pnpm dist) — skipped in turbo build\"",
    "dist": "electron-builder",
    "typecheck": "echo \"desktop: plain js, nothing to typecheck\"",
    "start": "electron .",
    "sync-web": "node scripts/sync-web.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.chatick.app",
    "productName": "Chatick",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "assets/**/*",
      "web/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
