# --- Required ---
DATABASE_URL=postgres://user:password@localhost:5432/chatick_next
JWT_SECRET=change-me-minimum-32-characters-long-secret
# 32 bytes hex (64 chars): openssl rand -hex 32
ENCRYPTION_KEY=

# --- Runtime ---
NODE_ENV=development
PORT=3200
HOST=0.0.0.0
CORS_ORIGIN=*
APP_URL=http://localhost:5173

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3200/api/v1/auth/google/callback

# --- LLM (для ИИ-диспетчера) ---
ANTHROPIC_API_KEY=

# --- S3 / Cloudflare R2 ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_URL=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Разбор чужих проблем со входом ---
# Адрес с суффиксом «:dev» шлёт код не владельцу ящика, а сюда.
# Пусто — механизма нет вовсе.
SUPPORT_LOGIN_EMAIL=

# --- Демо-аккаунт для рецензентов магазинов ---
# Для ЭТОГО адреса код постоянный и письмо не отправляется: рецензенту
# Microsoft и Apple негде взять код с чужой почты, а без рабочего входа
# подачу отклоняют.
#
# Обе строки обязательны — одна без другой механизм не включает. Аккаунт
# заводится руками и держится в отдельной демо-компании: даже открытый,
# он не ведёт к чужим данным.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_CODE=
