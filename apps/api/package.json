{
  "name": "@chatick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/check-bridge-guide.mjs && node scripts/check-mcp-sync.mjs",
    "check:guide": "node scripts/check-bridge-guide.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:seed-inbox": "tsx src/db/seed-inbox.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsc -p tsconfig.json && vitest run && node scripts/check-bridge-guide.mjs && node scripts/check-mcp-sync.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "jose": "^6.2.3",
    "lib0": "^0.2.117",
    "marked": "^18.0.9",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
