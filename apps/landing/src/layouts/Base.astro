---
import { createHash } from 'node:crypto'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { LOCALES, type LocaleCode } from '../i18n'

interface Props {
  locale: LocaleCode
  title: string
  description: string
}

const { locale, title, description } = Astro.props
const current = LOCALES.find((l) => l.code === locale)!
const canonical = new URL(current.path, Astro.site)

// Мессенджеры и поисковики не умеют относительные адреса — только полный URL.
// Версия — из содержимого файла: Telegram запоминает картинку по адресу и
// новую по тому же адресу не скачивает. Сменился og.png — сменился и адрес.
const ogVer = createHash('sha1').update(readFileSync(join(process.cwd(), 'public/og.png'))).digest('hex').slice(0, 10)
const ogImage = new URL(`/og.png?v=${ogVer}`, Astro.site).toString()

// Формат, который ждёт Open Graph: язык_СТРАНА.
const OG_LOCALE: Record<string, string> = { en: 'en_US', ru: 'ru_RU', he: 'he_IL' }
const ogLocale = OG_LOCALE[locale] ?? 'en_US'
---

<!doctype html>
<html lang={locale} dir={current.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(l.path, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Заголовок первого экрана набран Onest. Без preload браузер находит
        шрифт только после разбора CSS, и заголовок успевает мигнуть
        подстановочным. Иврит грузит Heebo. */}
    {locale === 'he' ? (
      <link rel="preload" href="/fonts/heebo-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    ) : (
      <link rel="preload" href={locale === 'ru' ? '/fonts/onest-cyrillic.woff2' : '/fonts/onest-latin.woff2'} as="font" type="font/woff2" crossorigin />
    )}
    <meta name="theme-color" content="#f2f3ef" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    {/* Карточка ссылки. Без og:image мессенджеры показывают голый текст, и
        ссылка выглядит подозрительно — по ней просто не переходят.
        Адрес абсолютный: относительный Telegram и Slack не разворачивают. */}
    <meta property="og:site_name" content="Chatick" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {LOCALES.filter((l) => l.code !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l.code]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Что это за штука — словами, понятными поисковику */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Chatick',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web, Windows, macOS',
        description,
        url: new URL('/', Astro.site).toString(),
        image: ogImage,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
    <script>
      // Автодетект языка: только на первом заходе на корень, уважаем явный выбор (localStorage)
      const KEY = 'chatick_lang'
      const saved = localStorage.getItem(KEY)
      const path = location.pathname
      const atRoot = path === '/' || path === '/index.html'
      if (!saved && atRoot) {
        const nav = (navigator.language || 'en').slice(0, 2)
        if (nav === 'ru') location.replace('/ru/')
        else if (nav === 'he' || nav === 'iw') location.replace('/he/')
      } else if (atRoot && (saved === 'ru' || saved === 'he')) {
        // Только известные языки: с любым другим значением replace('/') на
        // корне перезагружал бы страницу по кругу.
        location.replace(`/${saved}/`)
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Chatick landing — светлая «бумага», мох и лайм: тот же язык, что у стола
     в приложении. Лайм — только у действий и у того, чей ход. */
  :root {
    --paper: #f2f3ef;
    --ink: #16180f;
    --ink2: #4e524c;
    --ink3: #6c7068;
    --line: #dde0d8;
    --moss: #1f2b1b;
    --acc: #d4f36b;
    --hot: #e8551f;
    --font-mono: 'JetBrains Mono', 'Heebo', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  /* Шрифты свои, а не с CDN: IP читателя не уходит третьей стороне.
     Onest (OFL, текст лицензии рядом) — латиница и кириллица, переменная ось.
     Иврита в нём нет: его берёт Heebo, только ивритские буквы, 12 КБ. */
  @font-face {
    font-family: 'Onest';
    src: url('/fonts/onest-latin.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Onest';
    src: url('/fonts/onest-latin-ext.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+20A0-20AB, U+20AD-20C4, U+2113;
  }
  @font-face {
    font-family: 'Onest';
    src: url('/fonts/onest-cyrillic.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: 'Heebo';
    src: url('/fonts/heebo-hebrew.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
  }
  /* Моноширинный — для данных: часы, номера задач, метки за столом. */
  @font-face {
    font-family: 'JetBrains Mono';
    src: url('/fonts/jetbrains-mono.woff2') format('woff2');
    font-weight: 100 800;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2000-206F, U+2074,
      U+20AC, U+2116, U+2122, U+2190-2193, U+2212, U+2215, U+2713, U+25B6, U+25B8, U+2022,
      U+FEFF, U+FFFD;
  }
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    color-scheme: light;
    scroll-behavior: smooth;
    /* Страховка от бокового скролла: одного заехавшего вбок блока хватает,
       чтобы страница поехала целиком — на иврите это видно сразу. */
    overflow-x: hidden;
  }
  body {
    background: var(--paper);
    color: var(--ink);
    /* Heebo первым: его unicode-range забирает только иврит. */
    font-family: 'Heebo', 'Onest', system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a {
    color: inherit;
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  img {
    display: block;
    max-width: 100%;
  }
  :where(a, button, [tabindex]):focus-visible {
    outline: 2px solid #2f4fc2;
    outline-offset: 3px;
    border-radius: 8px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Шапка липкая: без запаса якорь уводит заголовок секции под неё */
  section[id] {
    scroll-margin-top: 84px;
  }
  /* Убирает 300-мс паузу перед нажатием на тач-экранах */
  a,
  button {
    touch-action: manipulation;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
