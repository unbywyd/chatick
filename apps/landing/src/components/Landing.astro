---
import { LOCALES, dict, type LocaleCode } from '../i18n'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const t = dict[locale]
const APP_URL = 'https://app.chatick.com'
const API_URL = 'https://api.chatick.com'
const SUPPORT = 'support@chatick.com'
const GITHUB = 'https://github.com/unbywyd/chatick'

// Кнопки скачивания пока без файлов: сборки ещё не выкладываются, и вести
// на пустоту хуже, чем честно сказать «скоро».
const WIN_ICON =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 5.6l7.2-1v6.9H3V5.6zm0 12.8l7.2 1v-6.8H3v5.8zM11.1 19.6L21 21v-8.3h-9.9v6.9zM11.1 3v7.5H21V2l-9.9 1z"/></svg>'
const APPLE_ICON =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.4 12.7c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.6-1.9-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.8-1.7 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.4 0 1.8.8 3.1.8 1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.5-1-2.5-3.8zM14 5.2c.7-.8 1.1-2 1-3.2-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.3z"/></svg>'
const VERSION = '0.2.2'
const DOWNLOADS = [
  { key: 'windows' as const, href: `/releases/Chatick-Setup-${VERSION}.exe`, icon: 'windows' },
  { key: 'mac' as const, href: '', icon: 'apple' },
]

// Цифры для графиков — то, что видно на овервью в самом продукте.
const CHART_HOURS = [
  { d: 'Mon', v: 6.5 },
  { d: 'Tue', v: 7.5 },
  { d: 'Wed', v: 5 },
  { d: 'Thu', v: 8 },
  { d: 'Fri', v: 6 },
  { d: 'Sat', v: 2 },
  { d: 'Sun', v: 1 },
]
const CHART_MAX = 8
const CHART_STATUSES = [
  { label: 'Done', v: 46, color: '#d4f228' },
  { label: 'In progress', v: 28, color: '#7fd1ff' },
  { label: 'Review', v: 14, color: '#ffc46b' },
  { label: 'To do', v: 12, color: '#6d7566' },
]
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={LOCALES.find((l) => l.code === locale)!.path}>
      <svg viewBox="0 0 48 48" fill="none" width="30" height="30" aria-hidden="true">
        <path
          d="M24 4C12.4 4 3 12.7 3 23.5c0 5.4 2.4 10.3 6.2 13.8L8 44l8.4-3.2c2.4.7 4.9 1.2 7.6 1.2 11.6 0 21-8.7 21-19.5S35.6 4 24 4Z"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="round"></path>
        <path d="M15 24.5 21 30l12-12" stroke="#d4f228" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <span>Chatick</span>
    </a>
    <div class="nav-actions">
      <nav class="langs" aria-label="Language">
        {
          LOCALES.map((l) => (
            <a href={l.path} class:list={['lang', { active: l.code === locale }]} data-lang={l.code} lang={l.code}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <a class="btn btn-sm" href={APP_URL}>{t.nav.start}</a>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <!-- Честно и сразу: человек должен понимать, что ставит -->
      <div class="beta-line">
        <span class="beta-badge">{t.beta.badge}</span>
        <span class="beta-note">{t.beta.note}</span>
      </div>
      <h1>
        {t.hero.title1}<span class="accent">{t.hero.titleAccent}</span>{t.hero.title2}
      </h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="hero-cta">
        <a class="btn" href={APP_URL}>
          {t.hero.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="arrow" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="#ask">{t.hero.ctaSecondary}</a>
        <!-- Сборка готова — предлагаем её сразу, а не прячем внизу страницы -->
        <a class="btn btn-ghost btn-win" href={DOWNLOADS[0]!.href} download>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M3 5.6l7.2-1v6.9H3V5.6zm0 12.8l7.2 1v-6.8H3v5.8zM11.1 19.6L21 21v-8.3h-9.9v6.9zM11.1 3v7.5H21V2l-9.9 1z"/></svg>
          {t.download.heroWin}
        </a>
      </div>
      <p class="note hero-note">{t.hero.note}</p>

      <!-- Три столпа — сразу в шапке, а не в подвале: опенсурс, бесплатно, надёжно -->
      <ul class="hero-trust">
        <li>
          <!-- «Открытый код» ведёт на код: обещание, которое можно проверить -->
          <a href={GITHUB} target="_blank" rel="noopener" title={t.footer.github}>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="#d4f228" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            {t.hero.trust[0]}
            <svg class="pill-out" viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
              <path d="M14 4h6v6M20 4l-8.5 8.5M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M12 3l1.9 5.6 5.6 1.4-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3z" fill="#d4f228" />
          </svg>
          {t.hero.trust[1]}
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M12 3l7 3v5.2c0 4.4-3 7.6-7 8.8-4-1.2-7-4.4-7-8.8V6l7-3z" stroke="#d4f228" stroke-width="2" stroke-linejoin="round" />
            <path d="m9 11.6 2 2 4-4" stroke="#d4f228" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t.hero.trust[2]}
        </li>
      </ul>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section">
    <div class="container">
      <h2>{t.pain.title}</h2>
      <div class="grid grid-4">
        {
          t.pain.items.map((item) => (
            <div class="card card-pain">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.solution.title}</h2>
      <p class="section-sub">{t.solution.subtitle}</p>
      <div class="grid grid-4">
        {
          t.solution.items.map((item) => (
            <div class="card card-solution">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORKSPACE: что ещё есть, кроме чата -->
  <section class="section">
    <div class="container">
      <h2>{t.workspace.title}</h2>
      <p class="section-sub">{t.workspace.subtitle}</p>
      <div class="grid grid-3">
        {
          t.workspace.items.map((item) => (
            <div class="card card-feature">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BRIDGE: подключение своего ИИ -->
  <section class="section section-soft">
    <div class="container">
      <div class="bridge">
        <div class="bridge-copy">
          <span class="tag">{t.bridge.tag}</span>
          <h2>{t.bridge.title}</h2>
          <p class="section-sub bridge-sub">{t.bridge.subtitle}</p>
          <ul class="bridge-points">
            {
              t.bridge.points.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                    <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="bridge-security">{t.bridge.security}</p>
        </div>
        <div class="bridge-demo" aria-hidden="true">
          <div class="term">
            <span class="term-dots"><i></i><i></i><i></i></span>
            <pre><code><span class="c-dim">you ▸</span> connect to my Chatick project
<span class="c-dim">ai  ▸</span> reading https://api.chatick.com/x
<span class="c-dim">ai  ▸</span> open app.chatick.com/#/connect
      and enter code <span class="c-accent">ABCD-2345</span>
<span class="c-dim">ai  ▸</span> connected as Artyom · My Project
<span class="c-dim">you ▸</span> what's on my plate?
<span class="c-dim">ai  ▸</span> 3 open tasks, 1 in review
</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ASK YOUR AI: копируемый промпт -->
  <section class="section ask" id="ask">
    <div class="container">
      <span class="tag">{t.ask.tag}</span>
      <h2>{t.ask.title}</h2>
      <p class="section-sub">{t.ask.subtitle}</p>

      <div class="prompt-box">
        <p class="prompt-text" id="prompt-text">{t.ask.prompt}</p>
        <button class="btn copy-btn" id="copy-prompt" data-copied={t.ask.copied}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
            <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="copy-label">{t.ask.copy}</span>
        </button>
      </div>
      <p class="note ask-hint">{t.ask.hint}</p>
    </div>
  </section>

  <!-- HOW -->
  <section class="section">
    <div class="container">
      <h2>{t.how.title}</h2>
      <div class="grid grid-3">
        {
          t.how.steps.map((step, i) => (
            <div class="card card-step">
              <span class="step-num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ЧИСЛА: что видно в самом продукте -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.workspace.title}</h2>
      <p class="section-sub">{t.workspace.subtitle}</p>

      <div class="charts">
        <!-- Часы за неделю -->
        <figure class="chart-card">
          <figcaption class="chart-head">
            <span class="chart-title">Hours this week</span>
            <span class="chart-total">34h 00m</span>
          </figcaption>
          <div class="bars" role="img" aria-label="Hours tracked per day this week">
            {
              CHART_HOURS.map((h) => (
                <div class="bar-col">
                  <div class="bar-track">
                    <div class="bar-fill" style={`height:${Math.round((h.v / CHART_MAX) * 100)}%`} />
                  </div>
                  <span class="bar-label">{h.d}</span>
                </div>
              ))
            }
          </div>
        </figure>

        <!-- Задачи по статусам -->
        <figure class="chart-card">
          <figcaption class="chart-head">
            <span class="chart-title">Tasks by status</span>
            <span class="chart-total">100</span>
          </figcaption>
          <div class="stack" role="img" aria-label="Share of tasks by status">
            {CHART_STATUSES.map((x) => <span class="stack-part" style={`width:${x.v}%;background:${x.color}`} />)}
          </div>
          <ul class="legend">
            {
              CHART_STATUSES.map((x) => (
                <li>
                  <i style={`background:${x.color}`} />
                  <span>{x.label}</span>
                  <b>{x.v}%</b>
                </li>
              ))
            }
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- ДОВЕРИЕ -->
  <section class="section">
    <div class="container">
      <h2>{t.trust.title}</h2>
      <p class="section-sub">{t.trust.subtitle}</p>

      <!-- Отдельной карточкой, а не пунктом в сетке: для компании это главное -->
      <div class="trust-lock">
        <span class="trust-lock-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none">
            <rect x="4" y="10.5" width="16" height="10" rx="2.5" stroke="currentColor" stroke-width="2" />
            <path d="M8 10.5V7a4 4 0 0 1 7.8-1.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
        <div>
          <h3>{t.trust.noLock.title}</h3>
          <p>{t.trust.noLock.text}</p>
        </div>
      </div>

      <div class="grid grid-3">
        {
          t.trust.items.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- СКАЧАТЬ -->
  <section class="section section-soft" id="download">
    <div class="container">
      <h2>{t.download.title}</h2>
      <p class="section-sub">{t.download.subtitle}</p>
      <div class="downloads">
        {
          DOWNLOADS.map((d) => (
            <a
              class:list={['dl', { 'dl-soon': !d.href }]}
              href={d.href || '#download'}
              aria-disabled={!d.href}
              download={d.href ? true : undefined}
            >
              <span class="dl-ic" set:html={d.icon === 'windows' ? WIN_ICON : APPLE_ICON} />
              <span class="dl-os">{t.download[d.key]}</span>
              {!d.href && <span class="dl-badge">{t.download.soon}</span>}
            </a>
          ))
        }
        <a class="dl dl-web" href={APP_URL}>
          <span class="dl-os">{t.download.web}</span>
        </a>
      </div>
      <p class="dl-warn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M12 9v4.5m0 3.2v.1M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {t.beta.warn}
      </p>
      <p class="note">{t.download.mobileSoon}</p>
    </div>
  </section>

  <!-- АВТОР -->
  <section class="section">
    <div class="container">
      <div class="author">
        <span class="tag">{t.author.tag}</span>
        <h2>{t.author.title}</h2>
        <p class="section-sub">{t.author.text}</p>
        <p class="author-sites">
          {t.author.sites}
          <a href="https://webtopro.com" target="_blank" rel="noopener">webtopro.com</a>
          <a href="https://unbywyd.com" target="_blank" rel="noopener">unbywyd.com</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ОТЗЫВЫ -->
  <section class="section section-soft" id="reviews">
    <div class="container">
      <h2>{t.reviews.title}</h2>
      <p class="section-sub">{t.reviews.subtitle}</p>

      <div class="reviews-grid" id="reviews-list" hidden></div>

      <!-- Пустое состояние — приглашение, а не серая строка -->
      <div class="reviews-empty" id="reviews-empty" hidden>
        <div class="stars-hero" aria-hidden="true">★★★★★</div>
        <p>{t.reviews.empty}</p>
      </div>

      <div class="review-actions">
        <button class="btn" id="review-open" type="button">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true"><path d="M12 3.3l2.7 5.4 6 .9-4.3 4.2 1 6-5.4-2.8-5.4 2.8 1-6L3.3 9.6l6-.9L12 3.3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          {t.reviews.leave}
        </button>
      </div>
    </div>
  </section>

  <!-- КОНТАКТЫ -->
  <section class="section" id="contact">
    <div class="container">
      <h2>{t.contact.title}</h2>
      <p class="section-sub">{t.contact.subtitle}</p>

      <form
        class="contact-card"
        id="contact-form"
        novalidate
        data-err-required={t.formErrors.required}
        data-err-email={t.formErrors.email}
        data-err-short={t.formErrors.short}
      >
        <div class="form-fields">
          <div class="form-row">
            <label>
              <span>{t.contact.name}</span>
              <input name="name" maxlength="120" autocomplete="name" placeholder={t.contact.ph.name} />
              <em class="err"></em>
            </label>
            <label>
              <span>{t.contact.email}</span>
              <input name="email" type="email" required autocomplete="email" placeholder={t.contact.ph.email} />
              <em class="err"></em>
            </label>
          </div>
          <!-- Свой список: нативный select не стилизуется и выглядит чужим -->
          <div class="sel" id="topic-sel">
            <span>{t.contact.topic}</span>
            <input type="hidden" name="topic" value="question" />
            <button type="button" class="sel-btn" aria-haspopup="listbox" aria-expanded="false">
              <span class="sel-value">{t.contact.topics.question}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <ul class="sel-menu" role="listbox" hidden>
              <li role="option" aria-selected="true" data-v="question">{t.contact.topics.question}</li>
              <li role="option" aria-selected="false" data-v="bug">{t.contact.topics.bug}</li>
              <li role="option" aria-selected="false" data-v="feature">{t.contact.topics.feature}</li>
              <li role="option" aria-selected="false" data-v="other">{t.contact.topics.other}</li>
            </ul>
          </div>
          <label>
            <span>{t.contact.message}</span>
            <textarea name="body" rows="4" required minlength="10" maxlength="5000" placeholder={t.contact.ph.message}></textarea>
            <em class="err"></em>
          </label>
          <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-actions">
            <button class="btn" type="submit">{t.contact.send}</button>
            <span class="form-msg" data-failed={t.contact.failed}></span>
          </div>
        </div>
        <div class="form-done" aria-live="polite">
          <span class="done-ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <p>{t.contact.sent}</p>
        </div>
      </form>

      <p class="contact-mail">
        {t.contact.support} <a href={`mailto:${SUPPORT}`}>{SUPPORT}</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p class="section-sub">{t.cta.subtitle}</p>
      <a class="btn" href={APP_URL}>{t.cta.button}</a>
    </div>
  </section>
</main>

<!-- Модалка отзыва: форма не мозолит глаза на странице, а приходит по кнопке -->
<div class="cmodal" id="review-modal" hidden>
  <div class="cmodal-backdrop" data-close></div>
  <div class="cmodal-card" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
    <button class="cmodal-x" type="button" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
