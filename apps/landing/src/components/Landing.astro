---
import { LOCALES, dict, type LocaleCode } from '../i18n'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const t = dict[locale]
const APP_URL = 'https://app.chatick.com'
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={LOCALES.find((l) => l.code === locale)!.path}>
      <svg viewBox="0 0 48 48" fill="none" width="30" height="30" aria-hidden="true">
        <path
          d="M24 4C12.4 4 3 12.7 3 23.5c0 5.4 2.4 10.3 6.2 13.8L8 44l8.4-3.2c2.4.7 4.9 1.2 7.6 1.2 11.6 0 21-8.7 21-19.5S35.6 4 24 4Z"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="round"></path>
        <path d="M15 24.5 21 30l12-12" stroke="#d4f228" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <span>Chatick</span>
    </a>
    <div class="nav-actions">
      <nav class="langs" aria-label="Language">
        {
          LOCALES.map((l) => (
            <a href={l.path} class:list={['lang', { active: l.code === locale }]} data-lang={l.code} lang={l.code}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <a class="btn btn-sm" href={APP_URL}>{t.nav.start}</a>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>
        {t.hero.title1}<span class="accent">{t.hero.titleAccent}</span>{t.hero.title2}
      </h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="hero-cta">
        <a class="btn" href={APP_URL}>
          {t.hero.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="arrow" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <span class="note">{t.hero.note}</span>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section">
    <div class="container">
      <h2>{t.pain.title}</h2>
      <div class="grid grid-4">
        {
          t.pain.items.map((item) => (
            <div class="card card-pain">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.solution.title}</h2>
      <p class="section-sub">{t.solution.subtitle}</p>
      <div class="grid grid-4">
        {
          t.solution.items.map((item) => (
            <div class="card card-solution">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="section">
    <div class="container">
      <h2>{t.how.title}</h2>
      <div class="grid grid-3">
        {
          t.how.steps.map((step, i) => (
            <div class="card card-step">
              <span class="step-num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p class="section-sub">{t.cta.subtitle}</p>
      <a class="btn" href={APP_URL}>{t.cta.button}</a>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container">
    <span>© 2026 Chatick. {t.footer.rights}</span>
  </div>
</footer>

<script>
  // Запоминаем явный выбор языка (для автодетекта на корне)
  document.querySelectorAll<HTMLAnchorElement>('.lang').forEach((a) =>
    a.addEventListener('click', () => localStorage.setItem('chatick_lang', a.dataset.lang!)),
  )
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    backdrop-filter: blur(12px);
    background: rgba(20, 22, 17, 0.82);
    border-bottom: 1px solid var(--border);
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .langs {
    display: flex;
    gap: 4px;
  }
  .lang {
    font-size: 0.8rem;
    color: var(--fg-muted);
    padding: 4px 9px;
    border-radius: 8px;
  }
  .lang:hover {
    color: var(--fg);
  }
  .lang.active {
    color: var(--lime);
    background: rgba(212, 242, 40, 0.1);
  }
  .btn-sm {
    padding: 8px 18px;
    font-size: 0.85rem;
  }

  .hero {
    padding: 110px 0 90px;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .accent {
    color: var(--lime);
  }
  .subtitle {
    max-width: 640px;
    margin: 26px auto 0;
    color: var(--fg-muted);
    font-size: 1.1rem;
  }
  .hero-cta {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .note {
    font-size: 0.82rem;
    color: var(--fg-muted);
  }
  .arrow {
    transition: transform 0.15s ease;
  }
  [dir='rtl'] .arrow {
    transform: scaleX(-1);
  }

  .section {
    padding: 80px 0;
  }
  .section-soft {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }
  h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    letter-spacing: -0.02em;
    text-align: center;
  }
  .section-sub {
    text-align: center;
    color: var(--fg-muted);
    margin-top: 12px;
  }
  .grid {
    display: grid;
    gap: 18px;
    margin-top: 44px;
  }
  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .section-soft .card {
    background: var(--bg);
  }
  .card h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .card p {
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .card-solution svg {
    margin-bottom: 12px;
  }
  .card-step {
    position: relative;
    padding-top: 30px;
  }
  .step-num {
    position: absolute;
    top: -16px;
    inset-inline-start: 22px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    background: var(--lime);
    color: var(--lime-dark);
    font-weight: 800;
    border-radius: 10px;
  }

  .cta {
    text-align: center;
    padding-bottom: 110px;
  }
  .cta .btn {
    margin-top: 30px;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 26px 0;
    color: var(--fg-muted);
    font-size: 0.82rem;
    text-align: center;
  }
</style>
