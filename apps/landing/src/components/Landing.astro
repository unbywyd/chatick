  <!-- КТО ЗА ЭТИМ СТОИТ -->
  {/* Прежний блок «автор» говорил только про разработчика, и продукт выглядел
      личным проектом одиночки. Здесь те же слова стоят рядом с заказчиком,
      который за это платит, — а это уже совсем другой уровень доверия. */}
  <section class="section" id="behind">
    <div class="container">
      <p class="tag">{t.behind.tag}</p>
      <h2>{t.behind.title}</h2>
      <p class="section-sub">{t.behind.subtitle}</p>

      <div class="behind">
        {/* StartPlan — якорь доверия, поэтому карточка крупнее остальных и
            единственная носит синий. Второго синего на странице нет.
            AnyApp стоит внутри этой же карточки, а не четвёртой в ряду:
            «дочерняя компания» — это отношение, и вложенность показывает его
            сама, без слов. Отдельной карточкой рядом они читались бы как две
            независимые фирмы. */}
        <article class="behind-card behind-sponsor">
          <a class="behind-logo-link" href={SITE_STARTPLAN} target="_blank" rel="noopener">
            <img class="behind-logo" src="/new-logo-light.svg" alt="StartPlan" width="668" height="197" loading="lazy" decoding="async" />
          </a>
          <p class="behind-role">{t.behind.sponsor.role}</p>
          <p class="behind-motto">{t.behind.sponsor.motto}</p>
          <p class="behind-text">{t.behind.sponsor.text}</p>

