---
import { LOCALES, type LocaleCode } from '../i18n'
import { copy } from '../copy'
import desktopPkg from '../../../desktop/package.json'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const c = copy[locale]
const here = LOCALES.find((l) => l.code === locale)!

// Язык в ссылке на приложение: chatick.com и app.chatick.com — разные origin,
// выбранный здесь язык туда сам не доедет. Приложение читает ?lng= первым делом.
const appUrl = `https://app.chatick.com/?lng=${locale}`
const GITHUB = 'https://github.com/unbywyd/chatick'
const SUPPORT = 'support@chatick.com'
const SITE_STARTPLAN = 'https://startplan.co.uk/'
const SITE_ANYAPP = 'https://any-app.com/'
// Our other products: the same section, in each site's own design, is on ungic.com, vexelkit.com and skey.tscodex.com.
const loc = locale === 'en' ? '' : `${locale}/`
const PRODUCTS = [
  { name: 'ungic', host: 'ungic.com', url: `https://ungic.com/${loc}`, text: c.products.ungic, tile: '#09090c',
    mark: '<svg viewBox="0 0 56 56" width="26" height="26" fill="none"><path d="M14 18 V34 a14 14 0 0 0 28 0 V26" stroke="#FFFFFF" stroke-width="8" stroke-linecap="round"/><circle cx="42" cy="12" r="5" fill="#6D5DFC"/></svg>' },
  { name: 'Vexelkit', host: 'vexelkit.com', url: `https://vexelkit.com/${locale}`, text: c.products.vexel, tile: '#f5f2eb',
    mark: '<svg viewBox="0 0 64 64" width="30" height="30"><rect x="5.5" y="5.5" width="53" height="53" rx="17" fill="#2BC874" transform="rotate(-8 32 32)"/></svg>' },
  { name: 'skey', host: 'skey.tscodex.com', url: 'https://skey.tscodex.com/', text: c.products.skey, tile: '#f4f2ec',
    mark: '<svg viewBox="0 0 24 24" width="28" height="28" fill="none"><circle cx="6.5" cy="12" r="3.75" stroke="#111110" stroke-width="2.2"/><path d="M10.25 12H22" stroke="#111110" stroke-width="2.2" stroke-linecap="round"/><rect x="14" y="14" width="8" height="4.5" rx="1" fill="#C93E12"/></svg>' },
]

// Версия — из десктопного package.json, того же, что electron-builder пишет в
// latest.yml: числом здесь она уже расходилась с релизом. Мак — двумя файлами
// (у arm64 и Intel разные сборки Electron). Windows — через Microsoft Store:
// пакет подписывает магазин, без SmartScreen и без прав администратора.
const VERSION = desktopPkg.version
const STORE_URL = 'https://apps.microsoft.com/detail/9n2dmzqhsnpn'
const WIN_EXE = `/releases/Chatick-Setup-${VERSION}.exe`
const MAC_ARM = `/releases/Chatick-${VERSION}-arm64.dmg`
const MAC_X64 = `/releases/Chatick-${VERSION}-x64.dmg`

const q = encodeURIComponent(c.ask.prompt)

/*
 * Стол в шапке — те же картинки, что у стола в приложении: стол сверху,
 * вокруг герои в креслах, мяч лежит перед тем, чей ход. Геометрия в единицах
 * сцены 600×600 (на экране сцена масштабируется скриптом под ширину).
 * Места по часовой стрелке от нижнего — «вы» сидите внизу, ближе к зрителю.
 */
const TABLE_IMG = 505 // слой стола 744, в нём стол 442 → стол 300 в сцене
const HANDS = 128 // руки героя лежат на бортике
const BOX = 116 // герой вписан в квадрат; тот, чей ход, ещё и крупнее (стили)
const LABEL_R = HANDS - 30 // имя — на сукне перед руками
const HIT_R = HANDS + 58
const HEROES = [
  { slug: 'robot', w: 360, h: 421 },
  { slug: 'owl', w: 360, h: 405 },
  { slug: 'girl', w: 360, h: 415 },
  { slug: 'dragon', w: 360, h: 402 },
  { slug: 'fox', w: 360, h: 355 },
]
const N = HEROES.length
const seats = HEROES.map((h, k) => {
  const a = 90 + ((k + 1) % N) * (360 / N) // «вы» (последний) — внизу, на 90°
  const r = (a * Math.PI) / 180
  const s = Math.min(BOX / h.w, BOX / h.h)
  return {
    ...h,
    a,
    name: c.hero.people[k],
    w: Math.round(h.w * s),
    h: Math.round(h.h * s),
    lab: { x: Math.round(300 + LABEL_R * Math.cos(r)), y: Math.round(300 + LABEL_R * Math.sin(r)) },
    hit: { x: Math.round(300 + HIT_R * Math.cos(r)), y: Math.round(300 + HIT_R * Math.sin(r)) },
  }
})
const T = {
  angles: seats.map((s) => s.a),
  names: c.hero.people,
  heat: c.hero.heat,
  moves: c.hero.moves,
  held: c.hero.held,
  day: locale === 'ru' ? 'д' : 'd',
}

const ICON_GH =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z'
---

<div class="lp">
  <header class="nav-bar">
    <div class="wrap nav">
      <a class="logo" href={here.path}>
        <i aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" width="20" height="20">
            <path
              d="M24 4C12.4 4 3 12.7 3 23.5c0 5.4 2.4 10.3 6.2 13.8L8 44l8.4-3.2c2.4.7 4.9 1.2 7.6 1.2 11.6 0 21-8.7 21-19.5S35.6 4 24 4Z"
              stroke="#EEF3E6"
              stroke-width="4"
              stroke-linejoin="round"></path>
            <path d="M15 24.5 21 30l12-12" stroke="#D4F36B" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </i>
        Chatick
      </a>
      <nav class="links" aria-label="Main">
        <a href="#how">{c.nav.how}</a>
        <a href="#heat">{c.nav.heat}</a>
        <a href="#dev">{c.nav.dev}</a>
        <a href="#own">{c.nav.own}</a>
        <a href="#download">{c.nav.download}</a>
      </nav>
      <nav class="langs" aria-label={c.nav.lang}>
        {
          LOCALES.map((l) => (
            <a href={l.path} class:list={['lang', { on: l.code === locale }]} data-lang={l.code} lang={l.code} aria-current={l.code === locale ? 'page' : undefined}>
              {l.code.toUpperCase()}
            </a>
          ))
        }
      </nav>
      <a class="ghb" href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub">
        <svg class="gi" viewBox="0 0 16 16" aria-hidden="true"><path d={ICON_GH}></path></svg>
      </a>
      <a class="btn sm ghost" href={appUrl}>{c.nav.signin}</a>
    </div>
  </header>

  <main class="wrap">
    <section class="hero" id="top">
      <div class="hero-copy">
        <span class="eyebrow"><i></i>{c.hero.eyebrow}</span>
        <h1 class="h1"><span>{c.hero.h1a}</span> <em>{c.hero.h1b}</em></h1>
        <p class="lead">{c.hero.lead}</p>
        <div class="ctas">
          <a class="btn pri" href={appUrl}>{c.hero.start}</a>
          <a class="btn acc" href="#ask">{c.hero.askAi}</a>
        </div>
        <p class="note">{c.hero.note}</p>
      </div>

      <figure class="stage-wrap" data-table aria-label={c.hero.scene}>
        <div class="hud" aria-hidden="true">
          <span class="heat" data-hud-heat>{c.hero.heat.warm} · {c.hero.people[0]}</span>
          <span data-hud-clock>{c.hero.held} 00:00:00</span>
          <span data-hud-task>TASK-100 · {c.hero.moves.do}</span>
        </div>
        <div class="stage">
        <div class="inner">
          <div class="spin">
            <img class="tab" src="/table/table.webp" alt="" width={TABLE_IMG} height={TABLE_IMG} style={`left:${(600 - TABLE_IMG) / 2}px;top:${(600 - TABLE_IMG) / 2}px`} />
            {
              seats.map((s, k) => (
                <div class="seat" style={`transform:rotate(${s.a - 270}deg)`}>
                  <img class:list={[{ on: k === 0 }]} data-hero src={`/heroes/${s.slug}.webp`} alt="" width={s.w} height={s.h} style={`bottom:${300 + HANDS}px`} />
                </div>
              ))
            }
            <img class="ball" data-ball src="/table/ball-warm.webp" alt="" width="52" height="52" />
            {
              seats.map((s, k) => (
                <span class:list={['lab', { on: k === 0 }]} data-lab style={`left:${s.lab.x}px;top:${s.lab.y}px`}>
                  <span>{s.name}</span>
                </span>
              ))
            }
            {
              seats.map((s, k) => (
                <button class="hit" data-pass={k} style={`left:${s.hit.x}px;top:${s.hit.y}px`} aria-label={c.hero.passTo.replace('{name}', s.name)}></button>
              ))
            }
          </div>
        </div>
        </div>
      </figure>
    </section>

    <section class="ask" id="ask">
      <div>
        <span class="kick">{c.ask.kick}</span>
        <h2 class="h2">{c.ask.title}</h2>
        <ol class="steps">{c.ask.steps.map((s, i) => <li><b>{i + 1}</b>{s}</li>)}</ol>
      </div>
      <div class="ask-r">
        <p class="pr mono" dir="auto">{c.ask.prompt}</p>
        <div class="ab">
          <button class="cpb" data-copy-text={c.ask.prompt} data-copied={c.ask.copied} data-label={c.ask.copy}>
            <svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="3"></rect><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2"></path></svg>
            <span>{c.ask.copy}</span>
          </button>
          <a class="aib" href={`https://chatgpt.com/?q=${q}`} target="_blank" rel="noopener">{c.ask.gpt} ↗</a>
          <a class="aib" href={`https://claude.ai/new?q=${q}`} target="_blank" rel="noopener">{c.ask.claude} ↗</a>
        </div>
      </div>
    </section>

    <section class="rules" id="how" aria-label={c.nav.how}>
      {
        c.rules.map((r, i) => (
          <div class="rule">
            <span class="n">0{i + 1}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))
      }
    </section>

    <section class="sec" id="heat">
      <h2 class="h2">{c.heat.title}</h2>
      <p class="sub">{c.heat.sub}</p>
      <div class="heatbar">
        {
          c.heat.items.map((h) => (
            <div class:list={['hb', h.key]}>
              <img src={`/table/ball-${h.key}.webp`} alt="" width="44" height="44" loading="lazy" />
              <b>{h.title}</b>
              <small>{h.text}</small>
              <span class="mono">{h.clock}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sec" id="dev">
      <h2 class="h2">{c.ways.title}</h2>
      <div class="two">
        <div class="card ui">
          <span class="k">{c.ways.ui.k}</span>
          <h3>{c.ways.ui.title}</h3>
          <p>{c.ways.ui.text}</p>
          <div class="throw">
            <span dir="auto">{c.ways.ui.task} <span class="at">{c.ways.ui.person}</span> <span class="hs">{c.ways.ui.project}</span></span>
            <kbd>↵</kbd>
          </div>
        </div>
        <div class="card mcp">
          <span class="k">{c.ways.dev.k}</span>
          <h3>{c.ways.dev.title}</h3>
          <p>{c.ways.dev.text}</p>
          <div class="code" dir="ltr">
            <div><span class="c">{c.ways.dev.comment}</span></div>
            <div><span class="f">chatick_handoff</span>(project=<span class="s">"vpure"</span>,</div>
            <div>&#160;&#160;task=<span class="s">"TASK-100"</span>, action=<span class="s">"review"</span>,</div>
            <div>&#160;&#160;to=<span class="s">"dana"</span>, note=<span class="s">"{c.ways.dev.note}"</span>)</div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="own">
      <span class="kick">{c.own.kick}</span>
      <h2 class="h2">{c.own.title}</h2>
      <div class="own">
        <div class="ow">
          <svg class="oi" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path></svg>
          <h3>{c.own.code.title}</h3>
          <p>{c.own.code.text}</p>
          <a class="ol" href={GITHUB} target="_blank" rel="noopener">{c.own.code.link}</a>
        </div>
        <div class="ow">
          <svg class="oi" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z"></path><path d="M4 7v10c0 1.7 3.6 3 8 3M20 7v4"></path><path d="M4 12c0 1.7 3.6 3 8 3"></path><path d="M17 14v6M14 17l3 3 3-3"></path></svg>
          <h3>{c.own.backup.title}</h3>
          <p>{c.own.backup.text}</p>
          <span class="ol mono">{c.own.backup.badge}</span>
        </div>
        <div class="ow">
          <svg class="oi" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"></rect><rect x="3" y="13" width="18" height="7" rx="2"></rect><path d="M7 7.5h.01M7 16.5h.01"></path></svg>
          <h3>{c.own.self.title}</h3>
          <p>{c.own.self.text}</p>
          <a class="ol" href={`${GITHUB}#getting-started`} target="_blank" rel="noopener">{c.own.self.link}</a>
        </div>
      </div>
    </section>

    <section class="sec" id="download">
      <h2 class="h2">{c.download.title}</h2>
      <p class="sub">{c.download.sub}</p>
      <div class="dl">
        <a class="dw win" href={STORE_URL} target="_blank" rel="noopener">
          <svg class="di" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5l7.5-1v7H3zM11.5 4.3L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.3z"></path></svg>
          <span><small>Windows</small><b>{c.download.winStore}</b></span>
          <em aria-hidden="true">↗</em>
        </a>
        <div class="dw mac">
          <svg class="di" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.5 2-3.6-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.9-3-.8a4.5 4.5 0 00-3.8 2.3c-1.6 2.8-.4 7 1.2 9.2.8 1.1 1.7 2.3 2.9 2.3s1.6-.8 3-.8 1.8.8 3 .7 2-1.1 2.8-2.2a9.6 9.6 0 001.2-2.5c-.1 0-2.4-.9-2.4-3.7zM14.2 5.6A3.4 3.4 0 0015 3a3.5 3.5 0 00-2.3 1.2 3.2 3.2 0 00-.8 2.5 2.9 2.9 0 002.3-1.1z"></path></svg>
          <span><small>macOS</small><b>{c.download.mac}</b>
            <span class="arch"><a href={MAC_ARM} download>{c.download.macArm} ↓</a><a href={MAC_X64} download>{c.download.macIntel} ↓</a></span>
          </span>
        </div>
        <a class="dw" href={appUrl}>
          <svg class="di line" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg>
          <span><small>{c.download.web}</small><b dir="ltr">{c.download.webSub}</b></span>
          <em aria-hidden="true">↗</em>
        </a>
      </div>
      <p class="dn">{c.download.macNote} <a href={WIN_EXE} download>{c.download.winDirect}</a></p>
    </section>

    <section class="sec" id="products">
      <h2 class="h2">{c.products.title}</h2>
      <p class="sub">{c.products.sub}</p>
      <div class="prods">
        {PRODUCTS.map((p) => (
          <a class="pr" href={p.url} target="_blank" rel="noopener">
            <i class="pr-mark" style={`background:${p.tile}`} aria-hidden="true" set:html={p.mark} />
            <b>{p.name}</b>
            <span>{p.text}</span>
            <em dir="ltr">{p.host} ↗</em>
          </a>
        ))}
      </div>
    </section>

    <section class="final">
      <h2 class="h2">{c.final.title}</h2>
      <a class="btn pri" href={appUrl}>{c.final.start}</a>
    </section>
  </main>

  <footer class="wrap foot">
    <span>© 2026 Chatick · {c.foot.backed} <a href={SITE_STARTPLAN} target="_blank" rel="noopener">StartPlan</a> · {c.foot.built} <a href={SITE_ANYAPP} target="_blank" rel="noopener">AnyApp</a></span>
    <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
    <a href="/changelog">{c.foot.changelog}</a>
    <a href="/ai.txt">{c.foot.forAi}</a>
    <a href={locale === 'en' ? '/integration' : `/${locale}/integration`}>{c.foot.integration}</a>
    <a href="/privacy">{c.foot.privacy}</a>
    <a href="/terms">{c.foot.terms}</a>
    <a href={`mailto:${SUPPORT}`}>{c.foot.contact}</a>
  </footer>
</div>

<script is:inline define:vars={{ T }}>
  ;(() => {
    // Стол в шапке живёт сам: мяч лежит, греется — и уходит к следующему.
    // Часы идут быстро: за несколько секунд — часы и дни, чтобы было видно,
    // как тепло становится жаром. Сроки — как в приложении: делать 3/5 дней,
    // проверить или ответить — 1/2 дня.
    const root = document.querySelector('[data-table]')
    if (!root) return
    const stage = root.querySelector('.stage')
    const inner = root.querySelector('.inner')
    const fit = () => inner.style.setProperty('--k', String(stage.clientWidth / 600))
    fit()
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(stage)

    const ball = root.querySelector('[data-ball]')
    const heroes = [...root.querySelectorAll('[data-hero]')]
    const labs = [...root.querySelectorAll('[data-lab]')]
    const hudHeat = root.querySelector('[data-hud-heat]')
    const hudClock = root.querySelector('[data-hud-clock]')
    const hudTask = root.querySelector('[data-hud-task]')
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const BALL_R = 50
    const INK = { warm: '#4D7A12', hot: '#855600', burn: '#C2410C' }
    const pos = (k) => {
      const r = (T.angles[k] * Math.PI) / 180
      return [Math.round(300 + BALL_R * Math.cos(r) - 26), Math.round(300 + BALL_R * Math.sin(r) - 26)]
    }
    // Ход: сколько «прожить» часов и сколько это длится на экране.
    const PLANS = [
      { move: 'do', sim: 6 * 3600, ms: 2600 },
      { move: 'review', sim: 32 * 3600, ms: 4200 },
      { move: 'do', sim: 20 * 3600, ms: 3000 },
      { move: 'answer', sim: 68 * 3600, ms: 6400 },
      { move: 'review', sim: 30 * 3600, ms: 4000 },
      { move: 'do', sim: 125 * 3600, ms: 6400 },
    ]
    const heatOf = (sec, move) => {
      const d = sec / 86400
      const [hot, burn] = move === 'do' ? [3, 5] : [1, 2]
      return d >= burn ? 'burn' : d >= hot ? 'hot' : 'warm'
    }
    const p2 = (n) => String(n).padStart(2, '0')
    const clock = (s) => {
      const d = Math.floor(s / 86400)
      return `${d ? d + T.day + ' ' : ''}${p2(Math.floor((s % 86400) / 3600))}:${p2(Math.floor((s % 3600) / 60))}:${p2(Math.floor(s % 60))}`
    }

    let holder = 0
    let prev = 1
    let turn = 0
    let start = performance.now()
    let heat = ''

    const place = (k) => {
      const [x, y] = pos(k)
      ball.style.left = x + 'px'
      ball.style.top = y + 'px'
    }
    const paint = (sec) => {
      const plan = PLANS[turn % PLANS.length]
      const h = heatOf(sec, plan.move)
      if (h !== heat) {
        heat = h
        ball.src = `/table/ball-${h}.webp`
        ball.classList.toggle('burn', h === 'burn')
        hudHeat.style.color = INK[h]
      }
      hudHeat.textContent = `${T.heat[h]} · ${T.names[holder]}`
      hudClock.textContent = `${T.held} ${clock(sec)}`
      hudTask.textContent = `TASK-100 · ${T.moves[plan.move]}`
    }
    const pass = (to) => {
      if (to === holder) return
      const [x0, y0] = pos(holder)
      const [x1, y1] = pos(to)
      prev = holder
      holder = to
      turn++
      start = performance.now()
      heroes.forEach((el, i) => el.classList.toggle('on', i === to))
      labs.forEach((el, i) => el.classList.toggle('on', i === to))
      place(to)
      paint(0)
      if (!still && ball.animate)
        ball.animate(
          [
            { left: x0 + 'px', top: y0 + 'px', scale: 1, filter: 'drop-shadow(0 0 5px rgba(0,0,0,.45))' },
            { scale: 1.5, filter: 'drop-shadow(0 0 16px rgba(0,0,0,.22))', offset: 0.5 },
            { left: x1 + 'px', top: y1 + 'px', scale: 1, filter: 'drop-shadow(0 0 5px rgba(0,0,0,.45))' },
          ],
          { duration: 720, easing: 'cubic-bezier(.3,.7,.4,1)' },
        )
    }
    // Следующий — то обратно тому, кто прислал («туда-сюда»), то кто-то другой.
    const next = () => {
      if (Math.random() < 0.45 && prev !== holder) return prev
      const rest = T.angles.map((_, i) => i).filter((i) => i !== holder)
      return rest[Math.floor(Math.random() * rest.length)]
    }

    place(holder)
    paint(0)
    root.querySelectorAll('[data-pass]').forEach((b) => b.addEventListener('click', () => pass(Number(b.dataset.pass))))

    // Не тратим кадры, когда стол не виден.
    let visible = true
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root)
    let last = performance.now()
    setInterval(() => {
      const now = performance.now()
      if (!visible || document.hidden) {
        start += now - last // пауза: ход не «прогорает», пока на него не смотрят
        last = now
        return
      }
      last = now
      const plan = PLANS[turn % PLANS.length]
      const f = Math.min(1, (now - start) / plan.ms)
      paint(f * plan.sim)
      if (f >= 1) pass(next())
    }, 100)
  })()

  // Явный выбор языка — для автодетекта на корне
  document.querySelectorAll('.lang').forEach((a) => a.addEventListener('click', () => localStorage.setItem('chatick_lang', a.dataset.lang)))

  // Скопировать подсказку для ассистента
  document.querySelectorAll('[data-copy-text]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copyText)
      } catch {
        return
      }
      const label = b.querySelector('span')
      b.classList.add('ok')
      label.textContent = b.dataset.copied
      clearTimeout(b._t)
      b._t = setTimeout(() => {
        b.classList.remove('ok')
        label.textContent = b.dataset.label
      }, 2400)
    }),
  )
</script>

