<script>
  // --- Что будет при установке --------------------------------------------
  // Раскрывается по кнопке, а не висит на странице: большинству читателей
  // достаточно знать, что подписи нет, и открыть браузерную версию.
  const howBtn = document.getElementById('howBtn')
  const howPop = document.getElementById('howPop')
  const howClose = document.getElementById('howClose')
  if (howBtn && howPop) {
    const toggle = (open: boolean) => {
      howPop.hidden = !open
      howBtn.setAttribute('aria-expanded', String(open))
    }
    howBtn.addEventListener('click', () => toggle(howPop.hidden))
    howClose?.addEventListener('click', () => {
      toggle(false)
      howBtn.focus()
    })
  }

  // --- Контактная форма ----------------------------------------------------
  // Лендинг статический, форма говорит с API напрямую. Валидация своя:
  // браузерные пузыри выглядят чужеродно и не переводятся вместе со страницей.
  const API = 'https://api.chatick.com'
  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/

  // --- свой выпадающий список ----------------------------------------------
  const topicSel = document.getElementById('topic-sel')
  if (topicSel) {
    const btn = topicSel.querySelector<HTMLButtonElement>('.sel-btn')!
    const menu = topicSel.querySelector<HTMLElement>('.sel-menu')!
    const label = topicSel.querySelector<HTMLElement>('.sel-value')!
    const hiddenInput = topicSel.querySelector<HTMLInputElement>('input[type=hidden]')!
    const options = Array.from(menu.querySelectorAll<HTMLElement>('[role=option]'))
    const setOpen = (v: boolean) => {
      menu.hidden = !v
      btn.setAttribute('aria-expanded', String(v))
    }
    const choose = (o: HTMLElement) => {
      hiddenInput.value = o.dataset.v ?? 'question'
      label.textContent = o.textContent
      options.forEach((x) => x.setAttribute('aria-selected', String(x === o)))
      setOpen(false)
      btn.focus()
    }
    btn.addEventListener('click', () => setOpen(menu.hidden))
    options.forEach((o) => o.addEventListener('click', () => choose(o)))

    /**
     * Управление с клавиатуры.
     *
     * Роли listbox/option были расставлены, но выбрать пункт можно было только
     * мышью: пункты не получали фокус, стрелки не работали. Программа чтения с
     * экрана объявляла список, который не поддаётся — хуже, чем если бы разметки
     * не было вовсе.
     */
    const focusAt = (i: number) => {
      const next = options[(i + options.length) % options.length]!
      options.forEach((x) => (x.tabIndex = x === next ? 0 : -1))
      next.focus()
    }
    options.forEach((o, i) => {
      o.tabIndex = o.getAttribute('aria-selected') === 'true' ? 0 : -1
      o.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); focusAt(i + 1) }
        else if (e.key === 'ArrowUp') { e.preventDefault(); focusAt(i - 1) }
        else if (e.key === 'Home') { e.preventDefault(); focusAt(0) }
        else if (e.key === 'End') { e.preventDefault(); focusAt(options.length - 1) }
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(o) }
      })
    })
    btn.addEventListener('keydown', (e) => {
      // Стрелка вниз с кнопки открывает список и ведёт внутрь — привычка,
      // выученная на нативном select.
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        if (menu.hidden) {
          e.preventDefault()
          setOpen(true)
          focusAt(Math.max(0, options.findIndex((x) => x.getAttribute('aria-selected') === 'true')))
        }
      }
    })

    // клик мимо и Esc закрывают — как у любого выпадающего
    document.addEventListener('click', (e) => {
      if (!topicSel.contains(e.target as Node)) setOpen(false)
    })
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || menu.hidden) return
      setOpen(false)
      // Фокус возвращаем на кнопку: иначе он остаётся на скрытом пункте и
      // следующий Tab уводит в неожиданное место.
      btn.focus()
    })
  }

  // --- валидация ------------------------------------------------------------
  type Field = HTMLInputElement | HTMLTextAreaElement

  function fieldError(form: HTMLFormElement, el: Field): string {
    const v = el.value.trim()
    if (el.required && !v) return form.dataset.errRequired ?? ''
    if (el instanceof HTMLInputElement && el.type === 'email' && v && !EMAIL_RE.test(v))
      return form.dataset.errEmail ?? ''
    const min = Number(el.getAttribute('minlength') ?? 0)
    if (min > 0 && v && v.length < min) return (form.dataset.errShort ?? '').replace('{n}', String(min))
    return ''
  }

  function validate(form: HTMLFormElement): boolean {
    // Тип пишем явно: присваивание происходит внутри forEach, анализ потока
    // этого не видит и сужает переменную до null — а тогда .focus() «не
    // существует». Поведение то же, ошибка проверки уходит.
    let firstBad = null as Field | null
    form.querySelectorAll<Field>('input[name]:not([type=hidden]):not(.trap), textarea[name]').forEach((el) => {
      const msg = fieldError(form, el)
      const err = el.parentElement?.querySelector<HTMLElement>('.err')
      if (err) err.textContent = msg
      el.classList.toggle('is-bad', Boolean(msg))
      if (msg && !firstBad) firstBad = el
    })
    firstBad?.focus()
    return !firstBad
  }

  // Ошибка гаснет, как только человек начал исправлять
  document.querySelectorAll<HTMLFormElement>('form[novalidate]').forEach((form) => {
    form.addEventListener('input', (e) => {
      const el = e.target
      if (!(el instanceof HTMLInputElement) && !(el instanceof HTMLTextAreaElement)) return
      el.classList.remove('is-bad')
      const err = el.parentElement?.querySelector<HTMLElement>('.err')
      if (err) err.textContent = ''
    })
  })

  // --- отправка -------------------------------------------------------------
  async function post(url: string, body: unknown) {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
    if (!r.ok) throw new Error(String(r.status))
    return r.json()
  }

  function showFail(form: HTMLFormElement) {
    const m = form.querySelector<HTMLElement>('.form-msg')
    if (m) m.textContent = m.dataset.failed ?? ''
  }
  function clearFail(form: HTMLFormElement) {
    const m = form.querySelector<HTMLElement>('.form-msg')
    if (m) m.textContent = ''
  }

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null
  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    clearFail(contactForm)
    if (!validate(contactForm)) return
    const f = new FormData(contactForm)
    const btn = contactForm.querySelector<HTMLButtonElement>('button[type=submit]')!
    btn.disabled = true
    try {
      await post(`${API}/api/v1/about/feedback`, {
        name: f.get('name'),
        email: f.get('email'),
        topic: f.get('topic'),
        body: f.get('body'),
        website: f.get('website'),
        page: location.href,
      })
      contactForm.classList.add('is-done')
    } catch {
      showFail(contactForm)
      btn.disabled = false
    }
  })
</script>

<script>
  // Запоминаем явный выбор языка (для автодетекта на корне)
  document.querySelectorAll<HTMLAnchorElement>('.lang').forEach((a) =>
    a.addEventListener('click', () => localStorage.setItem('chatick_lang', a.dataset.lang!)),
  )

  // Появление секций при прокрутке. Класс вешает скрипт, поэтому без JS и
  // при reduced-motion страница просто стоит целиком — движение здесь
  // приправа, а не условие чтения.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          e.target.classList.add('in-view')
          io.unobserve(e.target)
        }
      },
      { threshold: 0.12 },
    )
    document.querySelectorAll('.section .container').forEach((el) => {
      el.classList.add('will-reveal')
      io.observe(el)
    })
  }

  // Копирование инструкций для ИИ. Файл тянем по клику, а не заранее:
  // большинство читателей этими кнопками не воспользуется, и грузить ради них
  // сотню килобайт текста на каждом открытии страницы незачем.
  // data-copy-text — текст уже в разметке (короткая строка подключения),
  // data-copy — файл, который надо сначала скачать.
  document.querySelectorAll<HTMLButtonElement>('.doc-copy, .doc-copy-lg, [data-copy-text]').forEach((btn) => {
    const label = btn.querySelector('span')
    const original = label?.textContent ?? ''
    btn.addEventListener('click', async () => {
      try {
        const text = btn.dataset.copyText ?? (await fetch(btn.dataset.copy!).then((r) => r.text()))
        // Пустая строка в буфер — молчаливая пропажа: кнопка отчитается
        // «скопировано», а вставить будет нечего. Лучше уйти в запасной путь.
        if (!text) throw new Error('empty')
        await navigator.clipboard.writeText(text)
        if (label) label.textContent = btn.dataset.copied!
        btn.classList.add('done')
        setTimeout(() => {
          if (label) label.textContent = original
          btn.classList.remove('done')
        }, 2400)
      } catch {
        // Буфер закрыт (нет https, отказ в правах) — оставляем способ забрать
        // текст руками: файл открываем, а строку выделяем прямо на странице.
        if (btn.dataset.copy) {
          window.open(btn.dataset.copy, '_blank', 'noopener')
          return
        }
        const line = btn.parentElement?.querySelector('.bridge-line-text')
        if (!line) return
        const range = document.createRange()
        range.selectNodeContents(line)
        const sel = getSelection()
        sel?.removeAllRanges()
        sel?.addRange(range)
      }
    })
  })
</script>

