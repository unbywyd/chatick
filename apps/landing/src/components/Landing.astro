  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
  }
  .footer-dot {
    opacity: 0.5;
    margin-inline: 6px;
  }
  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* --- Вторая кнопка в hero --------------------------------------------- */
  .btn-ghost {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
  }
  .btn-ghost:hover {
    border-color: var(--lime);
    box-shadow: none;
  }

  /* --- Ярлык секции ------------------------------------------------------ */
  /* Ярлык секции больше не лаймовый: подпись — не действие, и красить её
     цветом кнопок значило звать нажать на неё. Моноширинный с решёткой,
     как заголовок раздела в README. */
  .tag {
    display: block;
    margin-bottom: 12px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tag::before {
    content: '# ';
    color: var(--lime);
  }
  /* На иврите решётка и разрядка не работают: диакритика едет, а знак
     оказывается не с той стороны фразы. */
  [dir='rtl'] .tag {
    font-family: inherit;
    letter-spacing: normal;
    text-transform: none;
  }
  [dir='rtl'] .tag::before {
    content: none;
  }
  /* Секции с заголовком по центру — ярлык там же. В «мосту» колонка
     выровнена по началу строки, и ярлык остаётся с ней. */
  #integrate .tag,
  .ask .tag,
  #behind .tag {
    text-align: center;
  }

  /* --- Возможности рабочего пространства -------------------------------- */
  .card-feature h3 {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* --- Мост для ИИ ------------------------------------------------------- */
  .bridge {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .bridge h2 {
    text-align: start;
  }
  .bridge-sub {
    text-align: start;
    margin-inline: 0;
  }
  .bridge-points {
    list-style: none;
    margin-top: 22px;
    display: grid;
    gap: 12px;
  }
  .bridge-points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--fg-muted);
    font-size: 0.94rem;
  }
  .bridge-points svg {
    flex: 0 0 auto;
    margin-top: 3px;
    color: var(--fg-muted);
  }
  .bridge-security {
    margin-top: 20px;
    font-weight: 700;
    color: var(--lime);
    font-size: 0.9rem;
  }
  /* Строка, которую человек реально вставляет себе в ассистента. Единственный
     акцентный блок в секции — на неё и должен упасть взгляд. */
  .bridge-line {
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--lime) 40%, var(--border));
    border-radius: var(--radius);
    padding: 16px;
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-bottom: 12px;
  }
  .bridge-line-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lime);
  }
  /* Направление наследуем от страницы: это фраза на языке читателя, а не код.
     Принудительный ltr рассыпал ивритское предложение — слова вставали
     задом наперёд. Адрес внутри разворачивается сам, по правилам bidi. */
  .bridge-line-text {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--fg);
    word-break: break-word;
  }
  .bridge-line-copy.done {
    background: #2b7a3d;
    color: #f4f5f0;
  }

  /* имитация терминала: показывает, что происходит после вставки строки */
  /* Терминал всегда читается слева направо, даже на иврите: это команды и
     адреса, а не текст. В RTL строки зеркалились — «you ▸» уезжало вправо,
     а точки-кнопки окна оказывались не с той стороны. */
  .term {
    direction: ltr;
    text-align: start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .term-dots {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
  }
  .term-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }
  /* Подпись в шапке окна: без неё диалог висел без объяснения, что это. */
  .term-dots em {
    margin-inline-start: 6px;
    font-style: normal;
    font-size: 0.74rem;
    color: var(--fg-muted);
  }
  .term-body {
    padding: 16px;
    display: grid;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  /* Реплики переводятся, и в русском они длиннее английских — перенос идёт
     по словам с отступом под метку, а не уводит читателя листать окно вбок. */
  .term-line {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  /* Метка фиксированной ширины: «you» длиннее «ai», без неё стрелки в столбце
     разъезжаются. */
  .term-line > .c-dim {
    flex: 0 0 auto;
    min-width: 3.2em;
    text-align: end;
    white-space: nowrap;
  }
  .term-line > span:last-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .c-dim {
    color: #6c7160;
  }
  .c-accent {
    color: var(--lime);
    font-weight: 700;
    /* Код вводят целиком — переносить его посередине нельзя */
    white-space: nowrap;
  }

  /* --- Спросите свой ИИ --------------------------------------------------- */
  .ask {
    text-align: center;
  }
  /* Секция «спросите свой ИИ» стала светлой полосой — коробка с промптом
     на ней должна быть темнее, а не того же тона. */
  .prompt-box {
    max-width: 720px;
    margin: 26px auto 0;
    padding: 20px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }
  .prompt-text {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.7;
    text-align: start;
    word-break: break-word;
  }
  .copy-btn {
    border: 0;
    cursor: pointer;
    font-size: 0.94rem;
    font-family: inherit;
  }
  .copy-btn.is-copied {
    background: #2b7a3d;
    color: #f4f5f0;
  }
  .ask-hint {
    margin-top: 14px;
  }

  /* Ссылки подвала стоят плотной строкой — высота отделяет их друг от друга */
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-muted);
  }
  /* Без пунктира: он читался как «недоступно» и мельтешил в ряду ссылок.
     Подчёркивание появляется при наведении — там оно и нужно. */
  .footer-link {
    text-decoration: none;
  }
  .footer-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-link:hover {
    color: var(--lime);
  }

  @media (max-width: 860px) {
    .bridge {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

<style>
  /* --- Отдать ассистенту (первый экран) ------------------------------------ */
  /* Карточка на месте бывшей схемы. Она не иллюстрация: с неё уходят в свой
     чат с ассистентом, поэтому вес такой же, как у кнопки «Начать» слева. */
  .hero-handoff {
    padding: 22px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .hero-handoff-title {
    margin: 0 0 14px;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
  }
  /* Строка всегда читается как код: моноширинный шрифт отделяет её от
     подписей вокруг, и видно, что копируют именно это. */
  .handoff-line {
    margin: 0;
    padding: 13px 15px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--fg);
    word-break: break-word;
  }
  .handoff-copy {
    width: 100%;
    margin-top: 12px;
    gap: 8px;
    justify-content: center;
  }
  .handoff-copy.done {
    background: var(--fg);
  }

  /* Шаги нумерует счётчик, а не маркеры списка: цифра здесь — часть рисунка,
     и её размер и цвет должны слушаться нас. */
  .hero-handoff-steps {
    list-style: none;
    counter-reset: handoff;
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
  }
  .hero-handoff-steps li {
    counter-increment: handoff;
    display: flex;
    align-items: baseline;
    gap: 9px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--fg-muted);
  }
  .hero-handoff-steps li::before {
    content: counter(handoff);
    flex: none;
    min-width: 1.1em;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--lime);
  }

  /* --- Скачивание --------------------------------------------------------- */
  /* Блок про отсутствие подписи: заметный, но не пугающий — это оговорка,
     а не предупреждение об опасности. */
  .unsigned {
    max-width: 640px;
    margin: 26px auto 0;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .unsigned-head {
    display: flex; align-items: center; justify-content: center; gap: 9px;
    font-weight: 700; color: var(--fg);
  }
  .unsigned-head svg { flex: 0 0 auto; color: var(--lime); }
  .unsigned-text { margin-top: 8px; color: var(--fg-muted); font-size: .94rem; }
  /* Прямой .exe: тише основного текста — это запасной путь, а не второй
     равноправный способ поставить приложение под Windows. */
  .unsigned-exe { margin-top: 10px; color: var(--fg-muted); font-size: .86rem; }
  .unsigned-exe a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  .unsigned-actions {
    margin-top: 14px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px;
  }
  .dl-small { padding: 10px 16px; font-size: .92rem; }
  .how-btn {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px;
    border: 0; background: none; cursor: pointer;
    color: var(--fg-muted); font: inherit; font-size: .9rem;
    padding: 6px 10px;
  }
  .how-btn:hover { color: var(--fg); }
  .how-mark {
    display: grid; place-items: center;
    width: 19px; height: 19px; border-radius: 50%;
    border: 1px solid currentColor; font-size: .72rem; font-weight: 700;
  }
  .how-pop {
    margin-top: 14px; padding: 16px 18px;
    border: 1px solid var(--border); border-radius: 12px;
    background: var(--bg);
  }
  .how-steps {
    margin: 0 auto; max-width: 460px;
    padding-inline-start: 20px;
    color: var(--fg-muted); font-size: .92rem;
    text-align: start;
  }
  .how-steps li + li { margin-top: 8px; }
  .how-source { margin-top: 12px; color: var(--fg-muted); font-size: .88rem; }
  .how-source a { color: var(--lime); text-decoration: underline; text-underline-offset: 3px; }
  .how-close {
    margin-top: 14px;
    border: 1px solid var(--border); border-radius: 999px;
    background: none; color: var(--fg); cursor: pointer;
    font: inherit; font-size: .88rem; padding: 10px 18px; min-height: 44px;
  }
  .how-close:hover { border-color: var(--lime); color: var(--lime); }

  /* Секция задаёт выравнивание сама: .section его не определяет, и по центру
     оказывались только заголовок с подзаголовком — у них свои стили. Кнопки,
     плашка и примечание оставались у левого края. */
  #download .container { text-align: center; }
  .downloads {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 28px 0 16px;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    border-radius: 999px;
    padding: 12px 22px;
    font-weight: 600;
    font-size: 0.93rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .dl:hover {
    border-color: rgba(212, 242, 40, 0.5);
    transform: translateY(-1px);
  }
  .dl-soon {
    opacity: 0.62;
    cursor: default;
  }
  .dl-soon:hover {
    transform: none;
    border-color: var(--border);
  }
  .dl-badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 8px;
  }
  /* Архитектура мака: подпись при названии ОС, а не отдельный ярлык — она
     уточняет кнопку, а не сообщает о её состоянии, как «скоро». */
  .dl-arch {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .dl-web {
    background: var(--lime);
    color: var(--lime-dark);
    border-color: transparent;
  }

  /* --- Кто за этим стоит --------------------------------------------------- */
  /* Карточка заказчика вдвое шире остальных: вес в сетке — это тоже
     утверждение о том, кто здесь главный аргумент. */
  .behind {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 18px;
    margin-top: 40px;
    align-items: stretch;
    text-align: start;
  }
  .behind-side {
    display: grid;
    gap: 18px;
    align-content: stretch;
  }
  .behind-card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px;
  }
  /* Синий живёт только здесь — на карточке заказчика. Сам #1b4dff слишком
     тёмен для текста на чёрном (3.2:1), поэтому он идёт заливкой и рамкой,
     а девиз набран его осветлённой версией. */
  .behind-sponsor {
    display: flex;
    flex-direction: column;
    border-color: color-mix(in srgb, var(--sp-blue) 40%, transparent);
    background: linear-gradient(
        160deg,
        color-mix(in srgb, var(--sp-blue) 14%, transparent),
        color-mix(in srgb, var(--sp-blue) 2%, transparent) 60%
      ),
      var(--bg-soft);
  }
  /* Логотип — ссылка на сайт компании. Обёртка отдельная, чтобы у цели была
     высота: сама картинка ниже 44px, и пальцем в неё не попасть.
     Стрелка после знака показывает, что уходим на чужой сайт, — иначе
     логотип выглядит просто картинкой и никто по нему не жмёт. */
  .behind-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-bottom: 18px;
    color: var(--fg-muted);
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .behind-logo-link::after {
    content: '';
    flex: none;
    width: 12px;
    height: 12px;
    background: currentColor;
    /* Стрелка «наружу» маской: свой цвет и никакого лишнего запроса */
    -webkit-mask: var(--ic-external) center / contain no-repeat;
    mask: var(--ic-external) center / contain no-repeat;
  }
  /* В RTL стрелка «наружу» смотрит в другую сторону — иначе она указывает
     обратно в текст, а не прочь от него. */
  [dir='rtl'] .behind-logo-link::after {
    transform: scaleX(-1);
  }
  .behind-logo-link:hover {
    opacity: 0.8;
    color: var(--fg);
  }
  .behind-logo {
    width: min(210px, 100%);
    height: auto;
  }

  /* Вложенный блок дочерней компании: отступ и линия слева говорят
     «это внутри StartPlan» раньше, чем человек дочитает подпись.
     Линия логическая — на иврите она сама уходит вправо. */
  .behind-sub {
    margin-top: 24px;
    padding-top: 20px;
    padding-inline-start: 18px;
    border-top: 1px solid var(--border);
    border-inline-start: 2px solid color-mix(in srgb, var(--sp-blue) 45%, transparent);
  }
  .behind-logo-link-sub {
    min-height: 40px;
    margin-bottom: 12px;
  }
  .behind-logo-sub {
    display: block;
    width: min(132px, 100%);
  }
  .behind-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }
  [dir='rtl'] .behind-role {
    font-family: inherit;
    letter-spacing: normal;
  }
  /* Девиз — голосом компании, поэтому крупнее текста и в цвете самой компании */
  .behind-motto {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: #8fa9ff;
    margin-bottom: 12px;
  }
  .behind-text {
    color: var(--fg-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .behind-mark {
    display: block;
    color: var(--fg);
    margin-bottom: 20px;
  }
  .behind-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .behind-links a {
    color: var(--lime);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .behind {
      grid-template-columns: 1fr;
    }
  }

  /* --- Подвал ------------------------------------------------------------- */
  .footer-col {
    display: grid;
    gap: 4px;
  }
  .footer-by a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-by a:hover {
    color: var(--fg);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 18px;
  }
  .footer-gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  @media (max-width: 700px) {
    .downloads .dl {
      flex: 1 1 100%;
      justify-content: center;
    }
    .footer-links {
      gap: 14px;
    }
  }
</style>

<style is:global>
  /* --- Знаки в блоке «кто за этим стоит» ------------------------------------ */
  /* Эти три знака вставлены через set:html, а такой разметке Astro не выдаёт
     свой data-атрибут — значит, из scoped-стилей до вложенного <svg> не
     дотянуться, и правила молча не срабатывали. Поэтому они здесь,
     глобальными. */
  .behind-mark svg {
    display: block;
    width: auto;
    height: 34px;
  }
  .behind-mark-wtp svg {
    height: 22px;
  }
  .behind-logo-sub svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* В знаке AnyApp слово набрано почти чёрным: на нашем фоне это 1.08:1,
     то есть его просто нет. Перекрашиваем только слово — четыре цветных
     треугольника фирменные и читаются как есть. */
  .behind-logo-sub [fill='#141A3A'] {
    fill: var(--fg);
  }

  /* --- Формы ---------------------------------------------------------------- */
  .contact-card {
    max-width: 600px;
    margin: 32px auto 0;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 26px;
  }
  .form-fields {
    display: grid;
    gap: 13px;
  }
  .form-row {
    display: grid;
