---
import { readFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { LOCALES, dict, type LocaleCode } from '../i18n'
import desktopPkg from '../../../desktop/package.json'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const t = dict[locale]
const APP_URL = 'https://app.chatick.com'

// Язык в ссылке на приложение. chatick.com и app.chatick.com — разные origin,
// и localStorage у них свой: выбранный на лендинге язык туда не доедет сам.
// Приложение читает ?lng= первым делом, поэтому передаём его явно.
const appUrl = `${APP_URL}/?lng=${locale}`
const API_URL = 'https://api.chatick.com'
const SUPPORT = 'support@chatick.com'
const GITHUB = 'https://github.com/unbywyd/chatick'
/** Скил живёт отдельно от основного репозитория: его ставят себе, а не читают. */
const SKILL_REPO = 'https://github.com/unbywyd/claude-skill-chatick'
// Сайты заказчика и его студии разработки — блок «кто за этим стоит»
const SITE_STARTPLAN = 'https://startplan.co.uk/'
const SITE_ANYAPP = 'https://any-app.com/'

// Кнопки скачивания пока без файлов: сборки ещё не выкладываются, и вести
// на пустоту хуже, чем честно сказать «скоро».
const WIN_ICON =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 5.6l7.2-1v6.9H3V5.6zm0 12.8l7.2 1v-6.8H3v5.8zM11.1 19.6L21 21v-8.3h-9.9v6.9zM11.1 3v7.5H21V2l-9.9 1z"/></svg>'
const APPLE_ICON =
  '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.4 12.7c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.6-1.9-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.8-1.7 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.4 0 1.8.8 3.1.8 1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.5-1-2.5-3.8zM14 5.2c.7-.8 1.1-2 1-3.2-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.3z"/></svg>'
// Версия берётся из десктопного package.json — того же, что electron-builder
// пишет в latest.yml. Раньше она стояла здесь числом и разошлась с релизом на
// три версии: кнопка вела на сборку, которой на сервере уже не было.
const VERSION = desktopPkg.version
// Мак собирается двумя файлами: у arm64 и Intel разные сборки Electron, одной
// универсальной нет. Кто не знает свою архитектуру — жмёт Apple Silicon: такие
// маки выпускают с 2020 года, и их подавляющее большинство.
// Windows ведёт в Microsoft Store: пакет подписывает магазин, поэтому там нет
// ни «неизвестного издателя», ни SmartScreen, и установка не требует прав
// администратора — для корпоративных машин это решает. Прямой .exe остаётся
// ниже, для тех, кому магазин недоступен.
const STORE_URL = 'https://apps.microsoft.com/detail/9n2dmzqhsnpn'
const WIN_EXE = `/releases/Chatick-Setup-${VERSION}.exe`

const DOWNLOADS = [
  { key: 'windows' as const, href: STORE_URL, icon: 'windows', arch: t.download.winStore, external: true },
  {
    key: 'mac' as const,
    href: `/releases/Chatick-${VERSION}-arm64.dmg`,
    icon: 'apple',
    arch: t.download.macArm,
  },
  {
    key: 'mac' as const,
    href: `/releases/Chatick-${VERSION}-x64.dmg`,
    icon: 'apple',
    arch: t.download.macIntel,
  },
]

// Знаки, нарисованные через currentColor, читаем с диска и вставляем в
// разметку: как <img> они не работают — картинка не знает про цвет текста
// вокруг и осталась бы чёрной на чёрном фоне. Файлы те же, что в public/,
// второй копии не заводим.
const asset = (name: string) => readFileSync(fileURLToPath(new URL(`../../public/${name}`, import.meta.url)), 'utf8')
const MARK_DEV = asset('unbywyd-mark.svg')
// Знак компании-разработчика (WebToPro), а не Chatick: у нашего логотипа
// свой инлайновый знак в шапке.
const MARK_WTP = asset('logo.svg')
// Знак AnyApp вставляем разметкой не ради currentColor, а чтобы дотянуться
// до тёмного слова внутри и перекрасить его: на чёрном фоне оно не читается.
const MARK_ANYAPP = asset('anyapp-logo-twotone-dark.svg')

---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={LOCALES.find((l) => l.code === locale)!.path}>
      <svg viewBox="0 0 48 48" fill="none" width="30" height="30" aria-hidden="true">
        <path
          d="M24 4C12.4 4 3 12.7 3 23.5c0 5.4 2.4 10.3 6.2 13.8L8 44l8.4-3.2c2.4.7 4.9 1.2 7.6 1.2 11.6 0 21-8.7 21-19.5S35.6 4 24 4Z"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="round"></path>
        <path d="M15 24.5 21 30l12-12" stroke="#d4f228" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <span>Chatick</span>
    </a>
    <div class="nav-actions">
      <nav class="langs" aria-label="Language">
        {
          LOCALES.map((l) => (
            <a href={l.path} class:list={['lang', { active: l.code === locale }]} data-lang={l.code} lang={l.code}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <!-- Копирование инструкций — здесь, а не отдельной секцией на экран.
           Разработчик вставляет их своему ассистенту, и ради этого не нужен
           разворот с заголовком и подзаголовком: нужны две кнопки. -->
      <button class="doc-copy" data-copy="/ai.txt" data-copied={t.ask.copied} title={t.ask.copyAi}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
          <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span>{t.ask.copyAi}</span>
      </button>
      <button class="doc-copy" data-copy="/integration.txt" data-copied={t.ask.copied} title={t.ask.copyApi}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
          <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span>{t.ask.copyApi}</span>
      </button>
      {/* Скил — то, с чего разработчик начинает, поэтому ссылка на него стоит
          в шапке рядом с «Начать». Ведёт на секцию, а не сразу на GitHub:
          сначала видно, что это и зачем, и только потом репозиторий. */}
      <a class="nav-skill" href="#skill">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span>{t.nav.skill}</span>
      </a>
      <a class="btn btn-sm" href={appUrl}>{t.nav.start}</a>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
      <!-- Честно и сразу: человек должен понимать, что ставит -->
      <div class="beta-line">
        <span class="beta-badge">{t.beta.badge}</span>
        <span class="beta-note">{t.beta.note}</span>
      </div>
      <h1>
        {t.hero.title1}<span class="accent">{t.hero.titleAccent}</span>{t.hero.title2}
      </h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="hero-cta">
        <a class="btn" href={appUrl}>
          {t.hero.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="arrow" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="/ai.txt">{t.hero.ctaSecondary}</a>
      </div>
      <p class="note hero-note">{t.hero.note}</p>

      <!-- Три столпа — сразу в шапке, а не в подвале: опенсурс, бесплатно, надёжно -->
      <ul class="hero-trust">
        <li>
          <!-- «Открытый код» ведёт на код: обещание, которое можно проверить -->
          <a href={GITHUB} target="_blank" rel="noopener" title={t.footer.github}>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            {t.hero.trust[0]}
            <svg class="pill-out" viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
              <path d="M14 4h6v6M20 4l-8.5 8.5M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M12 3l1.9 5.6 5.6 1.4-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3z" fill="currentColor" />
          </svg>
          {t.hero.trust[1]}
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M12 3l7 3v5.2c0 4.4-3 7.6-7 8.8-4-1.2-7-4.4-7-8.8V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="m9 11.6 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t.hero.trust[2]}
        </li>
      </ul>

      </div>

      {/* Главное действие страницы — на первом экране.
          Здесь была анимация «реплика в чате становится задачей»: она
          показывала, что продукт делает, но не давала ничего сделать. Строка
          ниже даёт: человек копирует её, отдаёт своему ассистенту, и тот
          читает ai.txt и подключается сам. Этого нет у трекеров, и незачем
          прятать это в середину страницы. */}
      <div class="hero-handoff">
        <p class="hero-handoff-title">{t.numbers.title}</p>
        {/* dir="auto", а не "ltr": строка на иврите — ивритская, и жёсткий LTR
            развернул бы её задом наперёд. Браузер смотрит на первую сильную
            букву и ставит направление сам. */}
        <p class="handoff-line" dir="auto">{t.ask.prompt}</p>
        <button class="btn handoff-copy" data-copy-text={t.ask.prompt} data-copied={t.ask.copied}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
            <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span>{t.ask.copy}</span>
        </button>
        <ol class="hero-handoff-steps">
          {t.numbers.steps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </div>
  </section>

  {/* Скил идёт до загрузки приложения: он и есть то, ради чего сюда приходят
      разработчики, а приложение — лишь способ подключаться в одну кнопку.
      Команды показаны целиком, с кнопкой копирования: разработчик вставляет
      их к себе, и заставлять его переписывать путь руками — верный способ
      получить опечатку. */}
  <section class="section section-soft" id="skill">
    <div class="container">
      <p class="tag">{t.skill.tag}</p>
      <h2>{t.skill.title}</h2>
      <p class="section-sub">{t.skill.subtitle}</p>

      <div class="skill-grid">
        <ol class="skill-steps">
          {
            t.skill.steps.map((step) => (
              <li>
                {/* Шаг с командой копируется, обычный текст — нет: копировать
                    «Перезапустите Claude Code» незачем. */}
                {step.startsWith('git ') || step.startsWith('node ') ? (
                  <button class="skill-cmd doc-copy" data-copy-text={step} data-copied={t.ask.copied} title={t.ask.copyCmd}>
                    <code>{step}</code>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
                      <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2" />
                      <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </button>
                ) : (
                  <span class="skill-plain">{step}</span>
                )}
              </li>
            ))
          }
        </ol>

        <ul class="skill-points">
          {
            t.skill.points.map((point) => (
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {point}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="skill-cta">
        <a class="btn" href={SKILL_REPO} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          {t.skill.cta}
        </a>
      </div>
      <p class="note skill-note">{t.skill.ctaNote}</p>

      {/* Что даёт MCP-сервер. Раньше он был одной фразой под кнопкой, и тот,
          кто решает, брать ли Chatick, не понимал, зачем это его команде —
          хотя это и есть отличие: ассистент работает внутри проекта, а не в
          отдельном чате. */}
      <div class="mcp">
        <h3>{t.skill.mcp.title}</h3>
        <p class="mcp-sub">{t.skill.mcp.subtitle}</p>
        <div class="mcp-grid">
          {
            t.skill.mcp.items.map((item) => (
              <div class="mcp-item">
                <p class="mcp-item-title">{item.title}</p>
                <p class="mcp-item-text">{item.text}</p>
              </div>
            ))
          }
        </div>
        <p class="note mcp-note">{t.skill.mcp.note}</p>
      </div>
    </div>
  </section>

  <section class="section" id="download">
    <div class="container">
      <h2>{t.download.title}</h2>
      <p class="section-sub">{t.download.subtitle}</p>
      {/* Браузер — путь без единого предупреждения, поэтому он первый и
          единственный крупной кнопкой. Сборки без подписи предлагать наравне
          нечестно: человек упрётся в окно SmartScreen, не понимая почему. */}
      {/* Четыре плитки в ряд: веб и три сборки. Раньше веб стоял отдельно, а
          десктоп прятался внутри блока про отсутствие подписи — читателю было
          не разобрать, что вообще есть. Плитки без теней и рамок, разделены
          только линиями: так они читаются как один выбор, а не четыре виджета. */}
      <div class="dl-grid">
        <a class="dl-tile dl-tile-web" href={appUrl}>
          <span class="dl-tile-ic">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
              <path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </span>
          <span class="dl-tile-name">{t.download.web}</span>
          <span class="dl-tile-note">{t.download.webNote}</span>
        </a>
        {
          DOWNLOADS.map((d) => (
            <a
              class:list={['dl-tile', { 'dl-tile-soon': !d.href }]}
              href={d.href || '#download'}
              aria-disabled={!d.href}
              download={d.href && !d.external ? true : undefined}
              target={d.external ? '_blank' : undefined}
              rel={d.external ? 'noopener' : undefined}
            >
              <span class="dl-tile-ic" set:html={d.icon === 'windows' ? WIN_ICON : APPLE_ICON} />
              <span class="dl-tile-name">{t.download[d.key]}</span>
              <span class="dl-tile-note">{d.arch || t.download.desktopNote}</span>
            </a>
          ))
        }
      </div>

      <p class="dl-warn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M12 9v4.5m0 3.2v.1M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {t.beta.warn}
      </p>

      {/* Оговорка про подпись осталась, но сузилась: Windows из магазина
          подписывает сам магазин, и предупреждений там нет. Она теперь про
          macOS и про прямой .exe — тот путь никуда не делся, он нужен там, где
          магазин закрыт политиками. */}
      <div class="unsigned">
        <div class="unsigned-head">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
            <path d="M12 9v4.5m0 3.2v.1M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
