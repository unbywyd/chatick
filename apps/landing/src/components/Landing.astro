            <path d="M8 10.5V7a4 4 0 0 1 7.8-1.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
        <div>
          <h3>{t.trust.noLock.title}</h3>
          <p>{t.trust.noLock.text}</p>
        </div>
      </div>

      <div class="grid grid-3">
        {
          t.trust.items.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
