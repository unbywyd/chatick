       Такие графики есть у любого трекера и не отвечают, чем мы отличаемся;
       а заголовок над ними обещал настоящие цифры. -->
  <!-- ДОВЕРИЕ -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.trust.title}</h2>
      <p class="section-sub">{t.trust.subtitle}</p>

