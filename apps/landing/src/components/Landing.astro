---
import { LOCALES, dict, type LocaleCode } from '../i18n'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const t = dict[locale]
const APP_URL = 'https://app.chatick.com'
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={LOCALES.find((l) => l.code === locale)!.path}>
      <svg viewBox="0 0 48 48" fill="none" width="30" height="30" aria-hidden="true">
        <path
          d="M24 4C12.4 4 3 12.7 3 23.5c0 5.4 2.4 10.3 6.2 13.8L8 44l8.4-3.2c2.4.7 4.9 1.2 7.6 1.2 11.6 0 21-8.7 21-19.5S35.6 4 24 4Z"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="round"></path>
        <path d="M15 24.5 21 30l12-12" stroke="#d4f228" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <span>Chatick</span>
    </a>
    <div class="nav-actions">
      <nav class="langs" aria-label="Language">
        {
          LOCALES.map((l) => (
            <a href={l.path} class:list={['lang', { active: l.code === locale }]} data-lang={l.code} lang={l.code}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <a class="btn btn-sm" href={APP_URL}>{t.nav.start}</a>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>
        {t.hero.title1}<span class="accent">{t.hero.titleAccent}</span>{t.hero.title2}
      </h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="hero-cta">
        <a class="btn" href={APP_URL}>
          {t.hero.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="arrow" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="#ask">{t.hero.ctaSecondary}</a>
        <span class="note">{t.hero.note}</span>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section">
    <div class="container">
      <h2>{t.pain.title}</h2>
      <div class="grid grid-4">
        {
          t.pain.items.map((item) => (
            <div class="card card-pain">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.solution.title}</h2>
      <p class="section-sub">{t.solution.subtitle}</p>
      <div class="grid grid-4">
        {
          t.solution.items.map((item) => (
            <div class="card card-solution">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORKSPACE: что ещё есть, кроме чата -->
  <section class="section">
    <div class="container">
      <h2>{t.workspace.title}</h2>
      <p class="section-sub">{t.workspace.subtitle}</p>
      <div class="grid grid-3">
        {
          t.workspace.items.map((item) => (
            <div class="card card-feature">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BRIDGE: подключение своего ИИ -->
  <section class="section section-soft">
    <div class="container">
      <div class="bridge">
        <div class="bridge-copy">
          <span class="tag">{t.bridge.tag}</span>
          <h2>{t.bridge.title}</h2>
          <p class="section-sub bridge-sub">{t.bridge.subtitle}</p>
          <ul class="bridge-points">
            {
              t.bridge.points.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                    <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="bridge-security">{t.bridge.security}</p>
        </div>
        <div class="bridge-demo" aria-hidden="true">
          <div class="term">
            <span class="term-dots"><i></i><i></i><i></i></span>
            <pre><code><span class="c-dim">you ▸</span> connect to my Chatick project
<span class="c-dim">ai  ▸</span> reading https://api.chatick.com/x
<span class="c-dim">ai  ▸</span> open app.chatick.com/#/connect
      and enter code <span class="c-accent">ABCD-2345</span>
<span class="c-dim">ai  ▸</span> connected as Artyom · My Project
<span class="c-dim">you ▸</span> what's on my plate?
<span class="c-dim">ai  ▸</span> 3 open tasks, 1 in review
</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ASK YOUR AI: копируемый промпт -->
  <section class="section ask" id="ask">
    <div class="container">
      <span class="tag">{t.ask.tag}</span>
      <h2>{t.ask.title}</h2>
      <p class="section-sub">{t.ask.subtitle}</p>

      <div class="prompt-box">
        <p class="prompt-text" id="prompt-text">{t.ask.prompt}</p>
        <button class="btn copy-btn" id="copy-prompt" data-copied={t.ask.copied}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
            <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="copy-label">{t.ask.copy}</span>
        </button>
      </div>
      <p class="note ask-hint">{t.ask.hint}</p>
    </div>
  </section>

  <!-- HOW -->
  <section class="section">
    <div class="container">
      <h2>{t.how.title}</h2>
      <div class="grid grid-3">
        {
          t.how.steps.map((step, i) => (
            <div class="card card-step">
              <span class="step-num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p class="section-sub">{t.cta.subtitle}</p>
      <a class="btn" href={APP_URL}>{t.cta.button}</a>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container footer-inner">
    <span>© 2026 Chatick. {t.footer.rights}</span>
    <a class="footer-link" href="/ai.txt">{t.footer.forAi}</a>
  </div>
</footer>

<script>
  // Запоминаем явный выбор языка (для автодетекта на корне)
  document.querySelectorAll<HTMLAnchorElement>('.lang').forEach((a) =>
    a.addEventListener('click', () => localStorage.setItem('chatick_lang', a.dataset.lang!)),
  )

  // Копирование промпта «спросите свой ИИ»
  const copyBtn = document.getElementById('copy-prompt')
  const promptEl = document.getElementById('prompt-text')
  if (copyBtn && promptEl) {
    const label = copyBtn.querySelector('.copy-label')!
    const original = label.textContent!
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(promptEl.textContent!.trim())
      } catch {
        // старые браузеры и http: выделяем текст, чтобы скопировать вручную
        const range = document.createRange()
        range.selectNodeContents(promptEl)
        const sel = window.getSelection()
        sel?.removeAllRanges()
        sel?.addRange(range)
      }
      label.textContent = copyBtn.dataset.copied!
      copyBtn.classList.add('is-copied')
      setTimeout(() => {
        label.textContent = original
        copyBtn.classList.remove('is-copied')
      }, 2400)
    })
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    backdrop-filter: blur(12px);
    background: rgba(20, 22, 17, 0.82);
    border-bottom: 1px solid var(--border);
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .langs {
    display: flex;
    gap: 4px;
  }
  .lang {
    font-size: 0.8rem;
    color: var(--fg-muted);
    padding: 4px 9px;
    border-radius: 8px;
  }
  .lang:hover {
    color: var(--fg);
  }
  .lang.active {
    color: var(--lime);
    background: rgba(212, 242, 40, 0.1);
  }
  .btn-sm {
    padding: 8px 18px;
    font-size: 0.85rem;
  }

  .hero {
    padding: 110px 0 90px;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .accent {
    color: var(--lime);
  }
  .subtitle {
    max-width: 640px;
    margin: 26px auto 0;
    color: var(--fg-muted);
    font-size: 1.1rem;
  }
  .hero-cta {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .note {
    font-size: 0.82rem;
    color: var(--fg-muted);
  }
  .arrow {
    transition: transform 0.15s ease;
  }
  [dir='rtl'] .arrow {
    transform: scaleX(-1);
  }

  .section {
    padding: 80px 0;
  }
  .section-soft {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }
  h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    letter-spacing: -0.02em;
    text-align: center;
  }
  .section-sub {
    text-align: center;
    color: var(--fg-muted);
    margin-top: 12px;
  }
  .grid {
    display: grid;
    gap: 18px;
    margin-top: 44px;
  }
  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .section-soft .card {
    background: var(--bg);
  }
  .card h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }
  .card p {
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .card-solution svg {
    margin-bottom: 12px;
  }
  .card-step {
    position: relative;
    padding-top: 30px;
  }
  .step-num {
    position: absolute;
    top: -16px;
    inset-inline-start: 22px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    background: var(--lime);
    color: var(--lime-dark);
    font-weight: 800;
    border-radius: 10px;
  }

  .cta {
    text-align: center;
    padding-bottom: 110px;
  }
  .cta .btn {
    margin-top: 30px;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 26px 0;
    color: var(--fg-muted);
    font-size: 0.82rem;
    text-align: center;
  }

  /* --- Вторая кнопка в hero --------------------------------------------- */
  .btn-ghost {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
  }
  .btn-ghost:hover {
    border-color: var(--lime);
    box-shadow: none;
  }

  /* --- Ярлык секции ------------------------------------------------------ */
  .tag {
    display: inline-block;
    margin-bottom: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(212, 242, 40, 0.12);
    color: var(--lime);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* --- Возможности рабочего пространства -------------------------------- */
  .card-feature h3 {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* --- Мост для ИИ ------------------------------------------------------- */
  .bridge {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .bridge h2 {
    text-align: start;
  }
  .bridge-sub {
    text-align: start;
    margin-inline: 0;
  }
  .bridge-points {
    list-style: none;
    margin-top: 22px;
    display: grid;
    gap: 12px;
  }
  .bridge-points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--fg-muted);
    font-size: 0.94rem;
  }
  .bridge-points svg {
    flex: 0 0 auto;
    margin-top: 3px;
  }
  .bridge-security {
    margin-top: 20px;
    font-weight: 700;
    color: var(--lime);
    font-size: 0.9rem;
  }
  /* имитация терминала: показывает, как выглядит подключение */
  .term {
    background: #0d0f0a;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .term-dots {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
  }
  .term-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }
  .term pre {
    padding: 16px;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.75;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .c-dim {
    color: #6c7160;
  }
  .c-accent {
    color: var(--lime);
    font-weight: 700;
  }

  /* --- Спросите свой ИИ --------------------------------------------------- */
  .ask {
    text-align: center;
  }
  .prompt-box {
    max-width: 720px;
    margin: 26px auto 0;
    padding: 20px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }
  .prompt-text {
    color: var(--fg);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86rem;
    line-height: 1.7;
    text-align: start;
    word-break: break-word;
  }
  .copy-btn {
    border: 0;
    cursor: pointer;
    font-size: 0.94rem;
    font-family: inherit;
  }
  .copy-btn.is-copied {
    background: #2b7a3d;
    color: #f4f5f0;
  }
  .ask-hint {
    margin-top: 14px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .footer-link {
    color: var(--fg-muted);
    border-bottom: 1px dotted var(--border);
  }
  .footer-link:hover {
    color: var(--lime);
  }

  @media (max-width: 860px) {
    .bridge {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
