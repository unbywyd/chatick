  <!-- КАК ЭТО РАБОТАЕТ -->
  <section class="section" id="integrate">
    <div class="container">
      <p class="tag">{t.integrate.tag}</p>
      <h2>{t.integrate.title}</h2>
      <p class="section-sub">{t.integrate.subtitle}</p>

      <ul class="integrate-list">
        {
          t.integrate.points.map((point) => (
            <li>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>

      {/* Две кнопки: человеку — страница, его ассистенту — машинный текст.
          Вторая ведёт прямо на /integration.txt, чтобы не заставлять искать
          её внутри страницы. */}
      <div class="integrate-cta">
        <a class="btn btn-brand" href={locale === 'en' ? '/integration' : `/${locale}/integration`}>
          {t.integrate.cta}
        </a>
        {/* Копирование, а не переход: текст предназначен для вставки в чужой
            чат с ассистентом, и открывать его человеку незачем. Ссылка рядом,
            в подписи, — страховка для тех, у кого буфер не сработал. */}
        <button class="btn btn-ghost doc-copy-lg" data-copy="/integration.txt" data-copied={t.ask.copied}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
            <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span>{t.integrate.ctaAi}</span>
        </button>
      </div>
      <p class="note integrate-note">
        {t.integrate.ctaAiNote}
        <a class="u-link" href="/integration.txt" target="_blank" rel="noopener">chatick.com/integration.txt</a>
      </p>
    </div>
  </section>


  <!-- HOW -->
  <section class="section">
    <div class="container">
      <h2>{t.pain.title}</h2>
      <div class="grid grid-4">
        {
          t.pain.items.map((item) => (
            <div class="card card-pain">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.solution.title}</h2>
      <p class="section-sub">{t.solution.subtitle}</p>
      <div class="grid grid-4">
        {
          t.solution.items.map((item) => (
            <div class="card card-solution">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORKSPACE: что ещё есть, кроме чата -->
  <section class="section">
    <div class="container">
      <h2>{t.workspace.title}</h2>
      <p class="section-sub">{t.workspace.subtitle}</p>
      <div class="grid grid-3">
        {
          t.workspace.items.map((item) => (
            <div class="card card-feature">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BRIDGE: подключение своего ИИ -->
  <section class="section section-soft">
    <div class="container">
      <div class="bridge">
        <div class="bridge-copy">
          <span class="tag">{t.bridge.tag}</span>
          <h2>{t.bridge.title}</h2>
          <p class="section-sub bridge-sub">{t.bridge.subtitle}</p>
          <ul class="bridge-points">
            {
              t.bridge.points.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                    <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="bridge-security">{t.bridge.security}</p>
        </div>
        {/* Заголовок обещает «одну строку» — значит строка должна быть здесь,
            видимой и копируемой. Раньше на её месте стоял терминал с выдуманным
            диалогом: читатель видел картинку, но не понимал, что именно ему
            делать. Теперь строка сверху — а терминал показывает, что будет
            после того, как её вставят. */}
        <div class="bridge-demo">
          <div class="bridge-line">
            <span class="bridge-line-label">{t.bridge.lineLabel}</span>
            <p class="bridge-line-text">{t.bridge.line}</p>
            <button class="btn btn-sm bridge-line-copy" data-copy-text={t.bridge.line} data-copied={t.bridge.lineCopied}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M5 15V6a1 1 0 0 1 1-1h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span>{t.bridge.lineCopy}</span>
            </button>
          </div>
          <div class="term" aria-hidden="true">
            <span class="term-dots"><i></i><i></i><i></i><em>{t.bridge.demoLabel}</em></span>
            {/* Строками, а не <pre>: в <pre> сохраняются переносы и отступы
                самого шаблона, и вёрстка утекала в текст. */}
            <div class="term-body">
              {
                t.bridge.demo.map((l) => (
                  <p class="term-line">
                    <span class="c-dim">{l.who === 'you' ? 'you' : 'ai'} ▸</span>
                    <span>
                      {l.text}
                      {l.code && <span class="c-accent">{l.code}</span>}
