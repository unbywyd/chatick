---
import { LOCALES, dict, type LocaleCode } from '../i18n'

interface Props {
  locale: LocaleCode
}

const { locale } = Astro.props
const t = dict[locale]
const APP_URL = 'https://app.chatick.com'
const API_URL = 'https://api.chatick.com'
const SUPPORT = 'support@chatick.com'
const GITHUB = 'https://github.com/unbywyd/chatick'

// Кнопки скачивания пока без файлов: сборки ещё не выкладываются, и вести
// на пустоту хуже, чем честно сказать «скоро».
const DOWNLOADS = [
  { key: 'windows' as const, href: '', icon: 'windows' },
  { key: 'mac' as const, href: '', icon: 'apple' },
  { key: 'linux' as const, href: '', icon: 'linux' },
]

// Цифры для графиков — то, что видно на овервью в самом продукте.
const CHART_HOURS = [
  { d: 'Mon', v: 6.5 },
  { d: 'Tue', v: 7.5 },
  { d: 'Wed', v: 5 },
  { d: 'Thu', v: 8 },
  { d: 'Fri', v: 6 },
  { d: 'Sat', v: 2 },
  { d: 'Sun', v: 1 },
]
const CHART_MAX = 8
const CHART_STATUSES = [
  { label: 'Done', v: 46, color: '#d4f228' },
  { label: 'In progress', v: 28, color: '#7fd1ff' },
  { label: 'Review', v: 14, color: '#ffc46b' },
  { label: 'To do', v: 12, color: '#6d7566' },
]
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href={LOCALES.find((l) => l.code === locale)!.path}>
      <svg viewBox="0 0 48 48" fill="none" width="30" height="30" aria-hidden="true">
        <path
          d="M24 4C12.4 4 3 12.7 3 23.5c0 5.4 2.4 10.3 6.2 13.8L8 44l8.4-3.2c2.4.7 4.9 1.2 7.6 1.2 11.6 0 21-8.7 21-19.5S35.6 4 24 4Z"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="round"></path>
        <path d="M15 24.5 21 30l12-12" stroke="#d4f228" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <span>Chatick</span>
    </a>
    <div class="nav-actions">
      <nav class="langs" aria-label="Language">
        {
          LOCALES.map((l) => (
            <a href={l.path} class:list={['lang', { active: l.code === locale }]} data-lang={l.code} lang={l.code}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <a class="btn btn-sm" href={APP_URL}>{t.nav.start}</a>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>
        {t.hero.title1}<span class="accent">{t.hero.titleAccent}</span>{t.hero.title2}
      </h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <div class="hero-cta">
        <a class="btn" href={APP_URL}>
          {t.hero.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="arrow" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="#ask">{t.hero.ctaSecondary}</a>
        <span class="note">{t.hero.note}</span>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section">
    <div class="container">
      <h2>{t.pain.title}</h2>
      <div class="grid grid-4">
        {
          t.pain.items.map((item) => (
            <div class="card card-pain">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.solution.title}</h2>
      <p class="section-sub">{t.solution.subtitle}</p>
      <div class="grid grid-4">
        {
          t.solution.items.map((item) => (
            <div class="card card-solution">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORKSPACE: что ещё есть, кроме чата -->
  <section class="section">
    <div class="container">
      <h2>{t.workspace.title}</h2>
      <p class="section-sub">{t.workspace.subtitle}</p>
      <div class="grid grid-3">
        {
          t.workspace.items.map((item) => (
            <div class="card card-feature">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BRIDGE: подключение своего ИИ -->
  <section class="section section-soft">
    <div class="container">
      <div class="bridge">
        <div class="bridge-copy">
          <span class="tag">{t.bridge.tag}</span>
          <h2>{t.bridge.title}</h2>
          <p class="section-sub bridge-sub">{t.bridge.subtitle}</p>
          <ul class="bridge-points">
            {
              t.bridge.points.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                    <path d="m5 13 4 4L19 7" stroke="#d4f228" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="bridge-security">{t.bridge.security}</p>
        </div>
        <div class="bridge-demo" aria-hidden="true">
          <div class="term">
            <span class="term-dots"><i></i><i></i><i></i></span>
            <pre><code><span class="c-dim">you ▸</span> connect to my Chatick project
<span class="c-dim">ai  ▸</span> reading https://api.chatick.com/x
<span class="c-dim">ai  ▸</span> open app.chatick.com/#/connect
      and enter code <span class="c-accent">ABCD-2345</span>
<span class="c-dim">ai  ▸</span> connected as Artyom · My Project
<span class="c-dim">you ▸</span> what's on my plate?
<span class="c-dim">ai  ▸</span> 3 open tasks, 1 in review
</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ASK YOUR AI: копируемый промпт -->
  <section class="section ask" id="ask">
    <div class="container">
      <span class="tag">{t.ask.tag}</span>
      <h2>{t.ask.title}</h2>
      <p class="section-sub">{t.ask.subtitle}</p>

      <div class="prompt-box">
        <p class="prompt-text" id="prompt-text">{t.ask.prompt}</p>
        <button class="btn copy-btn" id="copy-prompt" data-copied={t.ask.copied}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
            <path d="M5 15V5.5A2.5 2.5 0 0 1 7.5 3H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="copy-label">{t.ask.copy}</span>
        </button>
      </div>
      <p class="note ask-hint">{t.ask.hint}</p>
    </div>
  </section>

  <!-- HOW -->
  <section class="section">
    <div class="container">
      <h2>{t.how.title}</h2>
      <div class="grid grid-3">
        {
          t.how.steps.map((step, i) => (
            <div class="card card-step">
              <span class="step-num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ЧИСЛА: что видно в самом продукте -->
  <section class="section section-soft">
    <div class="container">
      <h2>{t.workspace.title}</h2>
      <p class="section-sub">{t.workspace.subtitle}</p>

      <div class="charts">
        <!-- Часы за неделю -->
        <figure class="chart-card">
          <figcaption class="chart-head">
            <span class="chart-title">Hours this week</span>
            <span class="chart-total">34h 00m</span>
          </figcaption>
          <div class="bars" role="img" aria-label="Hours tracked per day this week">
            {
              CHART_HOURS.map((h) => (
                <div class="bar-col">
                  <div class="bar-track">
                    <div class="bar-fill" style={`height:${Math.round((h.v / CHART_MAX) * 100)}%`} />
                  </div>
                  <span class="bar-label">{h.d}</span>
                </div>
              ))
            }
          </div>
        </figure>

        <!-- Задачи по статусам -->
        <figure class="chart-card">
          <figcaption class="chart-head">
            <span class="chart-title">Tasks by status</span>
            <span class="chart-total">100</span>
          </figcaption>
          <div class="stack" role="img" aria-label="Share of tasks by status">
            {CHART_STATUSES.map((x) => <span class="stack-part" style={`width:${x.v}%;background:${x.color}`} />)}
          </div>
          <ul class="legend">
            {
              CHART_STATUSES.map((x) => (
                <li>
                  <i style={`background:${x.color}`} />
                  <span>{x.label}</span>
                  <b>{x.v}%</b>
                </li>
              ))
            }
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- ДОВЕРИЕ -->
  <section class="section">
    <div class="container">
      <h2>{t.trust.title}</h2>
      <p class="section-sub">{t.trust.subtitle}</p>
      <div class="grid grid-3">
        {
          t.trust.items.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- СКАЧАТЬ -->
  <section class="section section-soft" id="download">
    <div class="container">
      <h2>{t.download.title}</h2>
      <p class="section-sub">{t.download.subtitle}</p>
      <div class="downloads">
        {
          DOWNLOADS.map((d) => (
            <a
              class:list={['dl', { 'dl-soon': !d.href }]}
              href={d.href || '#download'}
              aria-disabled={!d.href}
            >
              <span class="dl-os">{t.download[d.key]}</span>
              {!d.href && <span class="dl-badge">{t.download.soon}</span>}
            </a>
          ))
        }
        <a class="dl dl-web" href={APP_URL}>
          <span class="dl-os">{t.download.web}</span>
        </a>
      </div>
      <p class="note">{t.download.mobileSoon}</p>
    </div>
  </section>

  <!-- АВТОР -->
  <section class="section">
    <div class="container">
      <div class="author">
        <span class="tag">{t.author.tag}</span>
        <h2>{t.author.title}</h2>
        <p class="section-sub">{t.author.text}</p>
        <p class="author-sites">
          {t.author.sites}
          <a href="https://webtopro.com" target="_blank" rel="noopener">webtopro.com</a>
          <a href="https://unbywyd.com" target="_blank" rel="noopener">unbywyd.com</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ОТЗЫВЫ -->
  <section class="section section-soft" id="reviews">
    <div class="container">
      <h2>{t.reviews.title}</h2>
      <p class="section-sub">{t.reviews.subtitle}</p>

      <div class="grid grid-3" id="reviews-list" data-empty={t.reviews.empty}>
        <p class="note reviews-loading">…</p>
      </div>

      <div class="review-actions">
        <button class="btn btn-ghost" id="review-open" type="button">{t.reviews.leave}</button>
      </div>

      <form class="form" id="review-form" hidden>
        <div class="form-row">
          <label>
            <span>{t.reviews.name}</span>
            <input name="name" required maxlength="80" autocomplete="name" />
          </label>
          <label>
            <span>{t.reviews.role}</span>
            <input name="role" maxlength="80" />
          </label>
        </div>
        <div class="form-row">
          <label>
            <span>{t.reviews.email}</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <label>
            <span>{t.reviews.rating}</span>
            <select name="rating">
              <option value="5">★★★★★</option>
              <option value="4">★★★★☆</option>
              <option value="3">★★★☆☆</option>
              <option value="2">★★☆☆☆</option>
              <option value="1">★☆☆☆☆</option>
            </select>
          </label>
        </div>
        <label>
          <span>{t.reviews.text}</span>
          <textarea name="body" rows="4" required minlength="20" maxlength="2000"></textarea>
        </label>
        <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-actions">
          <button class="btn" type="submit">{t.reviews.send}</button>
          <button class="btn btn-ghost" type="button" id="review-cancel">{t.reviews.cancel}</button>
          <span class="form-msg" data-sent={t.reviews.sent} data-failed={t.reviews.failed}></span>
        </div>
      </form>
    </div>
  </section>

  <!-- КОНТАКТЫ -->
  <section class="section" id="contact">
    <div class="container">
      <h2>{t.contact.title}</h2>
      <p class="section-sub">{t.contact.subtitle}</p>

      <form class="form" id="contact-form">
        <div class="form-row">
          <label>
            <span>{t.contact.name}</span>
            <input name="name" maxlength="120" autocomplete="name" />
          </label>
          <label>
            <span>{t.contact.email}</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
        </div>
        <label>
          <span>{t.contact.topic}</span>
          <select name="topic">
            <option value="question">{t.contact.topics.question}</option>
            <option value="bug">{t.contact.topics.bug}</option>
            <option value="feature">{t.contact.topics.feature}</option>
            <option value="other">{t.contact.topics.other}</option>
          </select>
        </label>
        <label>
          <span>{t.contact.message}</span>
          <textarea name="body" rows="5" required minlength="10" maxlength="5000"></textarea>
        </label>
        <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-actions">
          <button class="btn" type="submit">{t.contact.send}</button>
          <span class="form-msg" data-sent={t.contact.sent} data-failed={t.contact.failed}></span>
        </div>
      </form>

      <p class="note contact-mail">
        {t.contact.support} <a href={`mailto:${SUPPORT}`}>{SUPPORT}</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p class="section-sub">{t.cta.subtitle}</p>
      <a class="btn" href={APP_URL}>{t.cta.button}</a>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <span>© {new Date().getFullYear()} Chatick. {t.footer.rights}</span>
      <span class="footer-by">
        {t.footer.madeBy}
        <a href="https://webtopro.com" target="_blank" rel="noopener">webtopro.com</a>
      </span>
    </div>
    <nav class="footer-links">
      <a class="footer-link" href="/terms">{t.footer.terms}</a>
      <a class="footer-link" href="/privacy">{t.footer.privacy}</a>
      <a class="footer-link" href="/changelog">{t.footer.changelog}</a>
      <a class="footer-link" href={`mailto:${SUPPORT}`}>{SUPPORT}</a>
      <a class="footer-link footer-gh" href={GITHUB} target="_blank" rel="noopener" title={t.footer.github}>
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span class="footer-gh-label">GitHub</span>
      </a>
      <a class="footer-link" href="/ai.txt">{t.footer.forAi}</a>
    </nav>
  </div>
</footer>

<script>
  // --- Отзывы и контактная форма ------------------------------------------
  // Лендинг статический, поэтому обе формы говорят с API напрямую. Ответ
  // показываем на месте: молчание в ответ на «Отправить» неотличимо от поломки.
  const API = 'https://api.chatick.com'

  function say(form: HTMLFormElement, ok: boolean) {
    const el = form.querySelector<HTMLElement>('.form-msg')
    if (!el) return
    el.textContent = ok ? el.dataset.sent! : el.dataset.failed!
    el.classList.toggle('is-ok', ok)
    el.classList.toggle('is-err', !ok)
  }

  async function post(url: string, body: unknown) {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
    if (!r.ok) throw new Error(String(r.status))
    return r.json()
  }

  // Опубликованные отзывы. Пусто — так и пишем, а не оставляем скелет.
  const list = document.getElementById('reviews-list')
  if (list) {
    fetch(`${API}/api/v1/reviews`)
      .then((r) => (r.ok ? r.json() : { items: [] }))
      .then((d: { items: { id: string; name: string; role: string; rating: number; body: string }[] }) => {
        if (!d.items?.length) {
          list.innerHTML = `<p class="note">${list.dataset.empty}</p>`
          return
        }
        list.innerHTML = d.items
          .map((x) => {
            const stars = '★'.repeat(Math.max(1, Math.min(5, x.rating))) + '☆'.repeat(5 - Math.max(1, Math.min(5, x.rating)))
            const esc = (v: string) => v.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!)
            return `<figure class="card review">
                <div class="stars">${stars}</div>
                <blockquote>${esc(x.body)}</blockquote>
                <figcaption>${esc(x.name)}${x.role ? ` · <span>${esc(x.role)}</span>` : ''}</figcaption>
              </figure>`
          })
          .join('')
      })
      .catch(() => {
        list.innerHTML = `<p class="note">${list.dataset.empty}</p>`
      })
  }

  // Форма отзыва раскрывается по кнопке: пустая форма на виду только пугает
  const openBtn = document.getElementById('review-open')
  const reviewForm = document.getElementById('review-form') as HTMLFormElement | null
  const cancelBtn = document.getElementById('review-cancel')
  openBtn?.addEventListener('click', () => {
    reviewForm?.removeAttribute('hidden')
    openBtn.setAttribute('hidden', '')
    reviewForm?.querySelector<HTMLInputElement>('input[name=name]')?.focus()
  })
  cancelBtn?.addEventListener('click', () => {
    reviewForm?.setAttribute('hidden', '')
    openBtn?.removeAttribute('hidden')
  })

  reviewForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const f = new FormData(reviewForm)
    const btn = reviewForm.querySelector<HTMLButtonElement>('button[type=submit]')!
    btn.disabled = true
    try {
      await post(`${API}/api/v1/reviews`, {
        name: f.get('name'),
        role: f.get('role'),
        email: f.get('email'),
        rating: Number(f.get('rating')),
        body: f.get('body'),
        website: f.get('website'), // приманка для ботов
        lang: document.documentElement.lang,
      })
      say(reviewForm, true)
      reviewForm.reset()
    } catch {
      say(reviewForm, false)
    } finally {
      btn.disabled = false
    }
  })

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null
  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const f = new FormData(contactForm)
    const btn = contactForm.querySelector<HTMLButtonElement>('button[type=submit]')!
    btn.disabled = true
    try {
      await post(`${API}/api/v1/about/feedback`, {
        name: f.get('name'),
        email: f.get('email'),
        topic: f.get('topic'),
        body: f.get('body'),
        website: f.get('website'),
        page: location.href,
      })
      say(contactForm, true)
      contactForm.reset()
    } catch {
      say(contactForm, false)
    } finally {
      btn.disabled = false
    }
  })
</script>

<script>
  // Запоминаем явный выбор языка (для автодетекта на корне)
  document.querySelectorAll<HTMLAnchorElement>('.lang').forEach((a) =>
    a.addEventListener('click', () => localStorage.setItem('chatick_lang', a.dataset.lang!)),
  )

  // Копирование промпта «спросите свой ИИ»
  const copyBtn = document.getElementById('copy-prompt')
  const promptEl = document.getElementById('prompt-text')
  if (copyBtn && promptEl) {
    const label = copyBtn.querySelector('.copy-label')!
    const original = label.textContent!
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(promptEl.textContent!.trim())
      } catch {
        // старые браузеры и http: выделяем текст, чтобы скопировать вручную
        const range = document.createRange()
        range.selectNodeContents(promptEl)
        const sel = window.getSelection()
        sel?.removeAllRanges()
        sel?.addRange(range)
      }
      label.textContent = copyBtn.dataset.copied!
      copyBtn.classList.add('is-copied')
      setTimeout(() => {
        label.textContent = original
        copyBtn.classList.remove('is-copied')
      }, 2400)
    })
  }
</script>

