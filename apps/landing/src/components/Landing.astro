<script>
  // --- Отзывы и контактная форма ------------------------------------------
  // Лендинг статический, формы говорят с API напрямую. Валидация своя:
  // браузерные пузыри выглядят чужеродно и не переводятся вместе со страницей.
  const API = 'https://api.chatick.com'
  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/

  const esc = (v: string) => v.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!)

  // --- список отзывов или пустое состояние --------------------------------
  const list = document.getElementById('reviews-list')
  const emptyBox = document.getElementById('reviews-empty')
  if (list && emptyBox) {
    fetch(`${API}/api/v1/reviews`)
      .then((r) => (r.ok ? r.json() : { items: [] }))
      .catch(() => ({ items: [] }))
      .then((d: { items?: { name: string; role: string; rating: number; body: string }[] }) => {
        const items = d.items ?? []
        if (!items.length) {
          emptyBox.hidden = false
          return
        }
        list.innerHTML = items
          .map((x) => {
            const n = Math.max(1, Math.min(5, x.rating))
            const stars = '★'.repeat(n) + `<span class="off">${'★'.repeat(5 - n)}</span>`
            return `<figure class="rcard">
                <div class="rstars">${stars}</div>
                <blockquote>${esc(x.body)}</blockquote>
                <figcaption><b>${esc(x.name)}</b>${x.role ? ` · ${esc(x.role)}` : ''}</figcaption>
              </figure>`
          })
          .join('')
        list.hidden = false
      })
  }

  // --- модалка -------------------------------------------------------------
  const modal = document.getElementById('review-modal')
  const openBtn = document.getElementById('review-open')
  const reviewForm = document.getElementById('review-form') as HTMLFormElement | null

  function openModal() {
    if (!modal) return
    modal.hidden = false
    document.documentElement.style.overflow = 'hidden' // страница под модалкой не крутится
    modal.querySelector<HTMLInputElement>('input[name=name]')?.focus()
  }
  function closeModal() {
    if (!modal) return
    modal.hidden = true
    document.documentElement.style.overflow = ''
  }
  openBtn?.addEventListener('click', openModal)
  modal?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal))
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal()
  })

  // --- звёзды: кликабельные, с живым предпросмотром ------------------------
  const pick = document.getElementById('starpick')
  const ratingInput = reviewForm?.querySelector<HTMLInputElement>('input[name=rating]') ?? null
  const stars = pick ? Array.from(pick.querySelectorAll('button')) : []
  const paint = (n: number) => stars.forEach((b, i) => b.classList.toggle('is-on', i < n))
  stars.forEach((b, i) => {
    b.addEventListener('click', () => {
      if (ratingInput) ratingInput.value = String(i + 1)
      paint(i + 1)
    })
    b.addEventListener('mouseenter', () => paint(i + 1))
  })
  pick?.addEventListener('mouseleave', () => paint(Number(ratingInput?.value ?? 5)))

  // --- свой выпадающий список ----------------------------------------------
  const topicSel = document.getElementById('topic-sel')
  if (topicSel) {
    const btn = topicSel.querySelector<HTMLButtonElement>('.sel-btn')!
    const menu = topicSel.querySelector<HTMLElement>('.sel-menu')!
    const label = topicSel.querySelector<HTMLElement>('.sel-value')!
    const hiddenInput = topicSel.querySelector<HTMLInputElement>('input[type=hidden]')!
    const options = Array.from(menu.querySelectorAll<HTMLElement>('[role=option]'))
    const setOpen = (v: boolean) => {
      menu.hidden = !v
      btn.setAttribute('aria-expanded', String(v))
    }
    btn.addEventListener('click', () => setOpen(menu.hidden))
    options.forEach((o) =>
      o.addEventListener('click', () => {
        hiddenInput.value = o.dataset.v ?? 'question'
        label.textContent = o.textContent
        options.forEach((x) => x.setAttribute('aria-selected', String(x === o)))
        setOpen(false)
      }),
    )
    // клик мимо и Esc закрывают — как у любого выпадающего
    document.addEventListener('click', (e) => {
      if (!topicSel.contains(e.target as Node)) setOpen(false)
    })
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false)
    })
  }

  // --- валидация ------------------------------------------------------------
  type Field = HTMLInputElement | HTMLTextAreaElement

  function fieldError(form: HTMLFormElement, el: Field): string {
    const v = el.value.trim()
    if (el.required && !v) return form.dataset.errRequired ?? ''
    if (el instanceof HTMLInputElement && el.type === 'email' && v && !EMAIL_RE.test(v))
      return form.dataset.errEmail ?? ''
    const min = Number(el.getAttribute('minlength') ?? 0)
    if (min > 0 && v && v.length < min) return (form.dataset.errShort ?? '').replace('{n}', String(min))
    return ''
  }

  function validate(form: HTMLFormElement): boolean {
    let firstBad: Field | null = null
    form.querySelectorAll<Field>('input[name]:not([type=hidden]):not(.trap), textarea[name]').forEach((el) => {
      const msg = fieldError(form, el)
      const err = el.parentElement?.querySelector<HTMLElement>('.err')
      if (err) err.textContent = msg
      el.classList.toggle('is-bad', Boolean(msg))
      if (msg && !firstBad) firstBad = el
    })
    firstBad?.focus()
    return !firstBad
  }

  // Ошибка гаснет, как только человек начал исправлять
  document.querySelectorAll<HTMLFormElement>('form[novalidate]').forEach((form) => {
    form.addEventListener('input', (e) => {
      const el = e.target
      if (!(el instanceof HTMLInputElement) && !(el instanceof HTMLTextAreaElement)) return
      el.classList.remove('is-bad')
      const err = el.parentElement?.querySelector<HTMLElement>('.err')
      if (err) err.textContent = ''
    })
  })

  // --- отправка -------------------------------------------------------------
  async function post(url: string, body: unknown) {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
    if (!r.ok) throw new Error(String(r.status))
    return r.json()
  }

  function showFail(form: HTMLFormElement) {
    const m = form.querySelector<HTMLElement>('.form-msg')
    if (m) m.textContent = m.dataset.failed ?? ''
  }
  function clearFail(form: HTMLFormElement) {
    const m = form.querySelector<HTMLElement>('.form-msg')
    if (m) m.textContent = ''
  }

  reviewForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    clearFail(reviewForm)
    if (!validate(reviewForm)) return
    const f = new FormData(reviewForm)
    const btn = reviewForm.querySelector<HTMLButtonElement>('button[type=submit]')!
    btn.disabled = true
    try {
      await post(`${API}/api/v1/reviews`, {
        name: f.get('name'),
        role: f.get('role'),
        email: f.get('email'),
        rating: Number(f.get('rating')),
        body: f.get('body'),
        website: f.get('website'), // приманка для ботов
        lang: document.documentElement.lang,
      })
      reviewForm.classList.add('is-done')
      // Показали «спасибо» — и через паузу тихо закрылись, вернув форму в ноль
      setTimeout(() => {
        closeModal()
        reviewForm.classList.remove('is-done')
        reviewForm.reset()
        if (ratingInput) ratingInput.value = '5'
        paint(5)
      }, 2600)
    } catch {
      showFail(reviewForm)
    } finally {
      btn.disabled = false
    }
  })

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null
  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    clearFail(contactForm)
    if (!validate(contactForm)) return
    const f = new FormData(contactForm)
    const btn = contactForm.querySelector<HTMLButtonElement>('button[type=submit]')!
    btn.disabled = true
    try {
      await post(`${API}/api/v1/about/feedback`, {
        name: f.get('name'),
        email: f.get('email'),
        topic: f.get('topic'),
        body: f.get('body'),
        website: f.get('website'),
        page: location.href,
      })
      contactForm.classList.add('is-done')
    } catch {
      showFail(contactForm)
      btn.disabled = false
    }
  })
</script>

<script>
  // Запоминаем явный выбор языка (для автодетекта на корне)
  document.querySelectorAll<HTMLAnchorElement>('.lang').forEach((a) =>
    a.addEventListener('click', () => localStorage.setItem('chatick_lang', a.dataset.lang!)),
  )

  // Копирование промпта «спросите свой ИИ»
  const copyBtn = document.getElementById('copy-prompt')
  const promptEl = document.getElementById('prompt-text')
  if (copyBtn && promptEl) {
    const label = copyBtn.querySelector('.copy-label')!
    const original = label.textContent!
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(promptEl.textContent!.trim())
      } catch {
        // старые браузеры и http: выделяем текст, чтобы скопировать вручную
        const range = document.createRange()
        range.selectNodeContents(promptEl)
        const sel = window.getSelection()
        sel?.removeAllRanges()
        sel?.addRange(range)
      }
      label.textContent = copyBtn.dataset.copied!
      copyBtn.classList.add('is-copied')
      setTimeout(() => {
        label.textContent = original
        copyBtn.classList.remove('is-copied')
      }, 2400)
    })
  }
</script>

